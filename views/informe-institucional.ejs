<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Informe institucional | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<% const reportPath=typeof contextMode!=='undefined'&&contextMode?'/control-interno/contexto':'/informes/institucional'; %>
<body class="app-body report-page <%= printMode?'report-print':'' %>">
<%- include('partials/navigation',{active:typeof contextMode!=='undefined'&&contextMode?'control-interno':'informes',pageTitle:typeof contextMode!=='undefined'&&contextMode?'Consulta de Control Interno':'Informes institucionales'}) %>
<main class="app-main" id="contenido" tabindex="-1"><section class="card">
<header class="report-heading"><div><h1>Informe de planes y seguimiento</h1><p>Consulta analítica. Contiene resultados aprobados y datos provisionales identificados; no constituye una publicación oficial.</p></div><span class="badge">Analítico</span></header>
<dl class="report-metadata"><dt>Institución</dt><dd><%= data.meta.institution %></dd><dt>Generado</dt><dd><time datetime="<%= data.meta.generatedAt %>"><%= new Intl.DateTimeFormat('es-CO',{dateStyle:'short',timeStyle:'short',timeZone:'America/Bogota'}).format(new Date(data.meta.generatedAt)) %> (Colombia)</time></dd><dt>Usuario generador</dt><dd>ID <%= data.meta.actorId %></dd><dt>Identificador</dt><dd><%= data.meta.id %></dd><dt>SHA256 del contenido</dt><dd class="report-digest"><%= data.meta.contentSha256 %></dd><dt>Filtros aplicados</dt><dd><%= Object.entries(data.filters).map(([k,v])=>(typeof filterLabels!=='undefined'?filterLabels[k]||k:k)+': '+v).join('; ')||'Sin filtros' %></dd></dl>
<% if(!printMode){ %>
<%- include('partials/related-views',{contextFilters:data.filters,currentPath:reportPath}) %>
<% if(data.meta.exportReady===false){ %><p class="alert" role="status">La consulta está disponible. Las exportaciones requieren activar el Bloque F; no se habilitan desde esta pantalla.</p><% } %>
<form class="form-grid report-filters" data-query-progress method="get" action="<%= reportPath %>">
<% for(const [key,label]of [['planId','ID del plan'],['processId','ID del proceso'],['objectiveId','ID del objetivo específico'],['activityId','ID de actividad'],['periodId','ID del período'],['anio','Año'],['trimestre','Trimestre']]){ %><div class="field"><label for="report-<%= key %>"><%= label %></label><input id="report-<%= key %>" name="<%= key %>" type="number" min="<%= key==='anio'?1000:1 %>" max="<%= key==='trimestre'?4:key==='anio'?9999:2147483647 %>" value="<%= filters[key]||'' %>"></div><% } %>
<div class="field"><label for="report-responsable">Responsable (coincidencia exacta)</label><input id="report-responsable" name="responsable" maxlength="150" value="<%= filters.responsable||'' %>"></div>
<div class="field"><label for="report-planState">Estado del expediente del plan</label><select id="report-planState" name="planState"><option value="">Todos</option><% for(const value of ['sin_expediente','borrador','presentado','en_revision','devuelto','aprobado']){ %><option value="<%= value %>" <%= filters.planState===value?'selected':'' %>><%= value.replaceAll('_',' ') %></option><% } %></select></div>
<div class="field"><label for="report-followupState">Estado del seguimiento</label><select id="report-followupState" name="followupState"><option value="">Todos</option><% for(const [value,label]of [['approved','Aprobado'],['pending','Pendiente'],['rejected','Rechazado'],['missing','Sin avance aprobado']]){ %><option value="<%= value %>" <%= filters.followupState===value?'selected':'' %>><%= label %></option><% } %></select></div>
<button class="btn btn-primary" type="submit">Consultar informe</button><span role="status" data-query-status hidden>Consultando el informe...</span><a class="btn btn-secondary" href="<%= reportPath %>">Limpiar filtros</a></form>
<% if(canExport&&data.meta.exportReady!==false){ %><div class="report-actions"><% for(const [format,label]of [['csv','Exportar CSV'],['pdf','Preparar impresión / PDF']]){ %><form action="/informes/institucional/exportar/<%= format %>" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><% for(const [k,v]of Object.entries(data.filters)){ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } %><button class="btn btn-secondary" type="submit"><%= label %></button></form><% } %></div><% } %>
<% }else{ %><p class="report-print-help">Usa el diálogo de impresión de tu navegador y selecciona Guardar como PDF. Se exporta esta consulta analítica autorizada, sin publicación institucional.</p><button class="btn btn-primary" data-report-print type="button">Imprimir / Guardar PDF</button><% } %>
<h2>Resultados aprobados por período</h2><p>Los pendientes no se sustituyen por cero. Cada trimestre conserva su propio promedio y cobertura. <%= data.meta.summaryScope %></p>
<% const percent=v=>typeof v==='number'?v.toFixed(1)+' %':v?.explicacion||'Información no disponible'; %>
<% if(data.summary.length){ %><div class="table-wrap" tabindex="0" role="region" aria-label="Indicadores por período"><table><thead><tr><th scope="col">Período</th><th scope="col">Programadas / exigibles</th><th scope="col">Con aprobación</th><th scope="col">Sin aprobación</th><th scope="col">Pendientes de decisión</th><th scope="col">Avance aprobado</th><th scope="col">Cobertura</th></tr></thead><tbody><% for(const s of data.summary){ %><tr><td><%= s.period.anio %> / T<%= s.period.trimestre %></td><td><%= s.activitiesDue %></td><td><%= s.activitiesApproved %></td><td><%= s.activitiesWithoutApproval %></td><td><%= s.activitiesPending %></td><td><%= percent(s.summary.promedioAvance) %></td><td><%= percent(s.summary.coberturaTrimestral) %></td></tr><% } %></tbody></table></div><% }else{ %><p class="empty-state">Información no disponible: no hay períodos para los filtros seleccionados.</p><% } %>
<h2>Planes, objetivos y actividades</h2><p>Programadas / exigibles conserva el criterio vigente: fecha final hasta el cierre del período. La fórmula del indicador es una referencia; no representa una medición calculada.</p>
<% if(data.activities.length){ %><div class="table-wrap" tabindex="0" role="region" aria-label="Actividades del informe"><table><thead><tr><th scope="col">Plan / proceso</th><th scope="col">Objetivo / actividad</th><th scope="col">Responsable</th><th scope="col">Estado del plan</th><th scope="col">Período</th><th scope="col">Avance aprobado</th><th scope="col">Indicador</th></tr></thead><tbody><% for(const a of data.activities){ %><tr><td><%= a.plan_nombre %><br><%= a.proceso||'Proceso no disponible' %></td><td><%= a.objetivo||'Objetivo no disponible' %><br><% if(!printMode){ %><a href="<%= reportPath+'?'+new URLSearchParams({...data.filters,activityId:a.id_actividad,...(a.id_periodo?{periodId:a.id_periodo}:{})}).toString() %>"><%= a.descripcion %></a><% }else{ %><%= a.descripcion %><% } %></td><td><%= a.responsable||a.responsable_principal||'Sin información' %></td><td><%- include('partials/record-state',{value:a.plan_estado}) %></td><td><%= a.id_periodo?a.anio+' / T'+a.trimestre:'Sin período' %></td><td><%= a.progress.quarterApproved==null?'Información no disponible':a.progress.quarterApproved.toFixed(1)+' %' %><% if(a.progress.quarterApproved!=null){ %><br><span class="badge status-approved">Dato aprobado</span><% } %></td><td><%= a.indicador||'Información no disponible' %><br><%= a.formula||'' %><br><%= a.unidad||'' %> <%= a.fuente||'' %></td></tr><% } %></tbody></table></div><% }else{ %><p class="empty-state">No hay actividades para estos filtros.</p><% } %>
<h2>Seguimientos y observaciones de Planeación</h2><% for(const s of data.followups){ %><details class="report-entry" <%= printMode?'open':'' %>><summary>Seguimiento <%= s.id_seguimiento %> / actividad <%= s.id_actividad %> — <%= s.estado==='approved'?'Aprobado':s.estado==='pending'?'Provisional: pendiente':'Rechazado, excluido de resultados aprobados' %></summary><p>Valor presentado: <%= s.porcentaje %> %. Autor ID <%= s.creado_por %>. Fecha recibida: <%= s.creado_en %>.</p><p><%= s.observaciones||'Sin observaciones del responsable' %></p><p>Planeación: <%= s.observacion_planeacion||'Sin observaciones registradas' %></p></details><% } %><% if(!data.followups.length){ %><p class="empty-state">Sin seguimientos en el detalle seleccionado.</p><% } %>
<h2>Evidencias autorizadas</h2><% for(const e of data.evidence){ %><p class="report-entry">Evidencia <%= e.id_evidencia %>, actividad <%= e.id_actividad %>: <% if(!printMode&&e.nombre_original&&e.bytes){ %><a href="/evidencias/<%= e.id_evidencia %>/descargar"><%= e.nombre_original %></a><% }else{ %><%= e.nombre_original||'Referencia histórica' %><% } %>. <%= e.decision_institucional==='approved'?'Verificación aprobada':e.decision_institucional==='rejected'?'Rechazada':'Sin aprobación institucional' %>. <%= e.observaciones||'' %></p><% } %><% if(!data.evidence.length){ %><p class="empty-state">Sin evidencias disponibles para esta consulta y tus permisos.</p><% } %>
<h2>Historial institucional del plan</h2><% for(const h of data.history){ %><p class="report-entry">Plan <%= h.id_plan %>: <%- include('partials/record-state',{value:h.accion}) %>, usuario ID <%= h.actor_id %>, <%= h.creado_en %>. <%= h.observacion||'' %></p><% } %><% if(!data.history.length){ %><p class="empty-state">Sin actuaciones disponibles.</p><% } %>
<p class="report-note"><%= data.meta.temporalBasis %> Las observaciones de Control Interno se consultan en su expediente independiente y no sustituyen decisiones de Planeación.</p>
</section></main></body></html>
