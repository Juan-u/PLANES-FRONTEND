<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistema Planes de Acción</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8">

    <!-- Tarjeta Principal del Login -->
    <div class="w-full max-w-4xl bg-white border border-slate-200 rounded-3xl shadow-2xl overflow-hidden flex flex-col md:flex-row min-h-[580px]">
        
        <!-- SECCIÓN IZQUIERDA: Formulario de Inicio de Sesión (Fondo Blanco) -->
        <div class="w-full md:w-1/2 p-8 sm:p-12 flex flex-col justify-between bg-white">
            
            <div>
                <!-- Encabezado -->
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-lg">
                        IH
                    </div>
                    <div>
                        <h1 class="text-xs font-semibold uppercase tracking-wider text-blue-700">Instituto del Huila</h1>
                        <p class="text-xs text-slate-500">Planes de Acción</p>
                    </div>
                </div>

                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">¡Bienvenido de nuevo!</h2>
                    <p class="text-slate-500 text-sm mt-1">Ingresa tus credenciales para acceder al sistema.</p>
                </div>

                <!-- Alerta de Error (EJS) -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl p-3.5 mb-6">
                        <i class="fa-solid fa-triangle-exclamation text-base shrink-0"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Formulario -->
                <form action="/login" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-700 mb-1.5">Correo Electrónico</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                <i class="fa-regular fa-envelope"></i>
                            </span>
                            <input type="email" name="correo" placeholder="ejemplo@correo.com"
                                class="w-full bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/20 transition-all duration-200" required>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-700 mb-1.5">Contraseña</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input type="password" name="contraseña" placeholder="••••••••"
                                class="w-full bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/20 transition-all duration-200" required>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-xs text-slate-500 pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input type="checkbox" class="rounded border-slate-300 bg-slate-50 text-blue-700 focus:ring-blue-600/20">
                            <span>Recordarme</span>
                        </label>
                        <a href="#" class="text-blue-700 hover:text-blue-800 font-medium transition-colors">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit"
                        class="w-full mt-2 bg-blue-700 hover:bg-blue-800 active:bg-blue-900 text-white font-medium py-3 rounded-xl shadow-lg shadow-blue-700/20 hover:shadow-blue-700/35 transition-all duration-200 flex items-center justify-center gap-2">
                        <span>Iniciar Sesión</span>
                        <i class="fa-solid fa-arrow-right text-sm"></i>
                    </button>
                </form>
            </div>

            <!-- Footer Izquierdo -->
            <div class="mt-8 pt-4 border-t border-slate-100 text-center md:text-left">
                <p class="text-xs text-slate-400">&copy; <%= new Date().getFullYear() %> Instituto del Huila. Todos los derechos reservados.</p>
            </div>
        </div>

        <!-- SECCIÓN DERECHA: Hero Banner Corporativo -->
        <div class="w-full md:w-1/2 bg-gradient-to-br from-blue-700 via-indigo-700 to-blue-900 p-8 sm:p-12 flex flex-col justify-between relative overflow-hidden">
            
            <!-- Elementos decorativos de fondo (Glows & Grids) -->
            <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-blue-400/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Header Derecho / Logo Corporativo -->
            <div class="relative z-10 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 flex items-center justify-center shadow-lg">
                        <span class="text-white text-xl font-black tracking-wider">IH</span>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold text-base leading-tight">Módulo Planeador</h3>
                        <p class="text-blue-200 text-xs">Gestión Estratégica</p>
                    </div>
                </div>
            </div>

            <!-- Texto Central / Propuesta de Valor -->
            <div class="relative z-10 my-auto py-8">
                <span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-xs font-medium text-blue-100 mb-4">
                    Plataforma Institucional
                </span>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight mb-3">
                    Optimiza y monitorea los planes de acción.
                </h3>
                <p class="text-blue-100/80 text-sm leading-relaxed">
                    Accede a las herramientas de planificación, seguimiento de metas e indicadores en tiempo real desde una sola plataforma integradora.
                </p>
            </div>

            <!-- Footer Derecho -->
            <div class="relative z-10 pt-4 border-t border-white/10 text-xs text-blue-200/80 flex items-center justify-between">
                <span>Sistema de Gestión</span>
                <span class="font-semibold text-white">v2.0</span>
            </div>

        </div>

    </div>

</body>
</html>