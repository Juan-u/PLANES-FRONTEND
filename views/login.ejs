<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión | Planes de Acción</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/app.js" defer></script>
</head>
<body class="auth-page" data-time-zone="America/Bogota">
    <main class="auth-shell">
            <section class="auth-context" aria-label="Planes de Acción e información local">
                <svg class="auth-topography auth-topography--context-top" viewBox="0 0 300 260" aria-hidden="true" focusable="false">
                    <path d="M197-18c34 8 64 24 79 49 17 28 11 55-5 79-14 21-16 41-4 60 14 22 17 45 4 66-15 24-43 35-75 34-28-1-49-12-72-9-24 3-46 17-70 13-27-4-48-24-50-49-2-22 12-39 17-60 5-23-1-47 8-70 10-25 34-44 62-49 32-6 69 14 91 5 17-7 1-42 15-69Z"/>
                    <path d="M198 8c27 7 49 19 61 39 13 22 7 43-7 62-13 18-13 34-2 51 12 18 13 35 2 52-13 20-35 28-61 27-24-1-42-10-62-7-21 3-39 14-59 11-22-3-39-19-40-39-1-18 10-32 14-50 4-20-1-40 7-59 8-20 27-35 50-40 26-5 57 12 75 5 15-6 1-34 22-52Z"/>
                    <path d="M197 33c20 5 36 14 45 29 9 16 4 31-7 45-10 13-10 25-2 37 9 13 9 26 1 38-9 14-26 20-45 19-17-1-31-7-46-5-15 2-29 10-43 8-16-2-28-14-29-28-1-13 7-23 10-36 3-14-1-29 5-42 6-14 20-25 36-29 19-4 41 8 55 4 11-4 2-24 20-40Z"/>
                    <path d="M195 57c14 4 25 10 31 21 6 11 2 21-5 31-7 9-7 17-1 25 6 9 6 18 1 26-7 10-18 14-31 13-12 0-22-5-32-3-11 1-20 7-30 5-11-1-19-9-20-19 0-9 5-16 7-25 2-10-1-20 3-29 4-10 14-17 25-20 13-3 28 6 38 3 8-3 2-16 14-28Z"/>
                </svg>
                <svg class="auth-topography auth-topography--context-bottom" viewBox="0 0 300 260" aria-hidden="true" focusable="false">
                    <path d="M197-18c34 8 64 24 79 49 17 28 11 55-5 79-14 21-16 41-4 60 14 22 17 45 4 66-15 24-43 35-75 34-28-1-49-12-72-9-24 3-46 17-70 13-27-4-48-24-50-49-2-22 12-39 17-60 5-23-1-47 8-70 10-25 34-44 62-49 32-6 69 14 91 5 17-7 1-42 15-69Z"/>
                    <path d="M198 8c27 7 49 19 61 39 13 22 7 43-7 62-13 18-13 34-2 51 12 18 13 35 2 52-13 20-35 28-61 27-24-1-42-10-62-7-21 3-39 14-59 11-22-3-39-19-40-39-1-18 10-32 14-50 4-20-1-40 7-59 8-20 27-35 50-40 26-5 57 12 75 5 15-6 1-34 22-52Z"/>
                    <path d="M197 33c20 5 36 14 45 29 9 16 4 31-7 45-10 13-10 25-2 37 9 13 9 26 1 38-9 14-26 20-45 19-17-1-31-7-46-5-15 2-29 10-43 8-16-2-28-14-29-28-1-13 7-23 10-36 3-14-1-29 5-42 6-14 20-25 36-29 19-4 41 8 55 4 11-4 2-24 20-40Z"/>
                    <path d="M195 57c14 4 25 10 31 21 6 11 2 21-5 31-7 9-7 17-1 25 6 9 6 18 1 26-7 10-18 14-31 13-12 0-22-5-32-3-11 1-20 7-30 5-11-1-19-9-20-19 0-9 5-16 7-25 2-10-1-20 3-29 4-10 14-17 25-20 13-3 28 6 38 3 8-3 2-16 14-28Z"/>
                </svg>
                <a class="brand auth-brand" href="/" aria-label="Planes de Acción, inicio">
                    <span class="brand-mark" aria-hidden="true">PA</span>
                    <span>Planes de Acción</span>
                </a>
                <div class="auth-introduction">
                    <h1>Planes de Acción</h1>
                    <p class="auth-institution">Instituto del Huila</p>
                    <p class="auth-subtitle">Sistema de Gestión Institucional</p>
                    <p class="auth-description">Un espacio para organizar los planes y dar seguimiento a la gestión.</p>
                </div>
                <div class="auth-local-date">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M7.5 3v4M16.5 3v4M4 9.5h16M7.5 13h.01M12 13h.01M16.5 13h.01M7.5 16.5h.01M12 16.5h.01"/></svg>
                    <time data-current-date aria-label="Fecha actual en Colombia"></time>
                </div>
                <section class="auth-weather" data-login-weather aria-labelledby="weather-title" aria-busy="true">
                    <span class="auth-weather__icon" data-weather-icon aria-hidden="true">…</span>
                    <div class="auth-weather__details">
                        <h2 id="weather-title">Villavicencio, Meta</h2>
                        <p data-weather-result aria-live="polite" aria-atomic="true">Consultando el clima…</p>
                        <small data-weather-updated></small>
                        <a class="auth-weather__source" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Fuente: Open-Meteo</a>
                    </div>
                </section>
            </section>
            <section class="card card--auth" aria-labelledby="login-title">
                <svg class="auth-topography auth-topography--form" viewBox="0 0 300 260" aria-hidden="true" focusable="false">
                    <path d="M197-18c34 8 64 24 79 49 17 28 11 55-5 79-14 21-16 41-4 60 14 22 17 45 4 66-15 24-43 35-75 34-28-1-49-12-72-9-24 3-46 17-70 13-27-4-48-24-50-49-2-22 12-39 17-60 5-23-1-47 8-70 10-25 34-44 62-49 32-6 69 14 91 5 17-7 1-42 15-69Z"/>
                    <path d="M198 8c27 7 49 19 61 39 13 22 7 43-7 62-13 18-13 34-2 51 12 18 13 35 2 52-13 20-35 28-61 27-24-1-42-10-62-7-21 3-39 14-59 11-22-3-39-19-40-39-1-18 10-32 14-50 4-20-1-40 7-59 8-20 27-35 50-40 26-5 57 12 75 5 15-6 1-34 22-52Z"/>
                    <path d="M197 33c20 5 36 14 45 29 9 16 4 31-7 45-10 13-10 25-2 37 9 13 9 26 1 38-9 14-26 20-45 19-17-1-31-7-46-5-15 2-29 10-43 8-16-2-28-14-29-28-1-13 7-23 10-36 3-14-1-29 5-42 6-14 20-25 36-29 19-4 41 8 55 4 11-4 2-24 20-40Z"/>
                    <path d="M195 57c14 4 25 10 31 21 6 11 2 21-5 31-7 9-7 17-1 25 6 9 6 18 1 26-7 10-18 14-31 13-12 0-22-5-32-3-11 1-20 7-30 5-11-1-19-9-20-19 0-9 5-16 7-25 2-10-1-20 3-29 4-10 14-17 25-20 13-3 28 6 38 3 8-3 2-16 14-28Z"/>
                </svg>
                <h2 id="login-title">Iniciar sesión</h2>
                <p class="auth-form-help">Ingresa con el correo de tu cuenta</p>

                <% if (error) { %>
                    <div class="alert error" role="alert"><%= error %></div>
                <% } %>

                <form action="/login" method="POST" data-loading-form>
                    <div class="form-group">
                        <label for="correo">Correo electrónico</label>
                        <span class="auth-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                            <input class="form-control" type="email" id="correo" name="correo" autocomplete="username" required>
                        </span>
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <span class="password-field auth-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8 2 2-2 2 2 2-3 3-2-2-2 2"/></svg>
                            <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required>
                            <button class="password-toggle" type="button" data-password-toggle aria-controls="password" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/><path class="password-eye-slash" d="m4 4 16 16"/></svg></button>
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit">Ingresar</button>
                </form>
            </section>
    </main>
</body>
</html>
