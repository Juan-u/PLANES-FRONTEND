<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Detalle de actividad | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>"><%- include('partials/navigation', { active: 'actividad-detalle', pageTitle: 'Detalle de actividad', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>
  <% const displayLabel = (value) => typeof labelForDisplay === 'function' ? labelForDisplay(value) : (value ?? 'Sin estado'); %>
<main id="contenido" tabindex="-1" class="container"><section class="card" aria-labelledby="activity-title"><div class="page-heading"><div><h1 id="activity-title">Actividad #<%= activity.id_actividad %></h1><p>Detalle de la actividad asociada al plan #<%= activity.id_plan %>.</p></div></div>
<dl><dt>Descripción</dt><dd><%= activity.descripcion ?? 'Sin descripción' %></dd><dt>Responsable</dt><dd><%= activity.responsable ?? 'Sin responsable' %></dd><dt>Fecha de inicio</dt><dd><%- include('partials/record-date', { value: activity.fecha_inicio }) %></dd><dt>Fecha de fin</dt><dd><%- include('partials/record-date', { value: activity.fecha_fin }) %></dd><dt>Estado</dt><dd><span class="status-pill record-status" data-state="<%= activity.estado %>"><%= displayLabel(activity.estado) %></span></dd></dl>
<%- include('partials/related-views',{contextFilters:{planId:activity.id_plan,activityId:activity.id_actividad},currentPath:'/actividades/'+activity.id_actividad}) %>
<%- include('partials/institutional-read', { draft: activity.institucional }) %>
<% if (canReadEvidence) { %><h2>Evidencias registradas</h2><% if (evidences.length) { %><ul><% evidences.forEach((item) => { %><li><strong><%- include('partials/record-date', { value: item.fecha_subida }) %></strong> · <% if (item.nombre_original) { %><a href="/evidencias/<%= item.id_evidencia %>/descargar"><%= item.nombre_original %></a> (<%= item.bytes %> bytes)<% } else { %>Archivo heredado sin archivo privado asociado<% } %> · <%= item.observaciones ?? 'Sin observaciones' %></li><% }); %></ul><% } else { %><p class="empty-state">No hay metadatos de evidencias registrados.</p><% } %><% } %>
<% const integratedUpload=typeof evidenceIntegration!=='undefined'&&evidenceIntegration;const context=typeof quarterlyContext!=='undefined'?quarterlyContext:null; %><% if(typeof evidenceError!=='undefined'&&evidenceError){ %><p class="alert alert-error" role="alert"><%= evidenceError %></p><% } %><% if(context){ %><section class="institutional-section"><h2>Contexto trimestral</h2><p><%= context.period?.anio||'' %> / Trimestre <%= context.period?.trimestre||'' %></p><a href="/seguimiento?activityId=<%= activity.id_actividad %>">Consultar avance, historial y evidencias vinculadas</a></section><% } %><% if(canUploadEvidence&&integratedUpload){ %><%- include('partials/evidence-upload',{activity,evidences,evidenceIntegration:integratedUpload,quarterlyContext:context,csrfToken}) %><% } %><% if (canUploadEvidence && !integratedUpload) { %><h2>Cargar evidencia</h2><p id="upload-error" class="alert alert-error" role="alert" hidden></p><form id="evidence-upload" action="/evidencias/cargar" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_actividad" value="<%= activity.id_actividad %>"><div class="field"><label for="evidence-file">Archivo (PDF, PNG, JPEG o texto; máximo 64 KB)</label><input id="evidence-file" type="file" accept="application/pdf,image/png,image/jpeg,text/plain" required></div><div class="field"><label for="evidence-notes">Observaciones</label><textarea id="evidence-notes" name="observaciones" rows="3" maxlength="2000"></textarea></div><button class="btn btn-primary" type="submit">Subir evidencia</button></form><script>
document.getElementById('evidence-upload').addEventListener('submit', async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const file = document.getElementById('evidence-file').files[0];
  const error = document.getElementById('upload-error');
  if (!file || file.size > 65536) { error.hidden = false; error.textContent = 'Selecciona un archivo permitido de hasta 64 KB.'; return; }
  try {
    const dataUrl = await new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });
    const content = String(dataUrl).split(',')[1];
    const response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ csrfToken: form.elements.csrfToken.value, id_actividad: form.elements.id_actividad.value, nombre_original: file.name, mime_type: file.type, contenido_base64: content, observaciones: document.getElementById('evidence-notes').value }) });
    if (!response.ok) throw new Error('upload');
    window.location.reload();
  } catch { error.hidden = false; error.textContent = 'No fue posible cargar el archivo. Verifica el tipo y vuelve a intentar.'; }
});
</script><% } %>
<a class="btn btn-secondary" href="/actividades">Volver a actividades</a></section></main></body></html>
