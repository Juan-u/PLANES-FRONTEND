<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Roles y permisos | Planes de Acción</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>">
  <%- include('partials/navigation', { active: 'roles', pageTitle: 'Roles y permisos', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>
  <% const displayLabel = (value) => typeof labelForDisplay === 'function' ? labelForDisplay(value) : (value ?? 'Sin estado'); %>
  <% const permissionDetails = (permission) => typeof permissionDetailsForDisplay === 'function' ? permissionDetailsForDisplay(permission.code) : { name: permission.description ?? permission.code ?? 'Permiso no identificado', description: 'No hay una descripción disponible para este permiso.' }; %>
  <% const roleDescription = (role) => typeof roleDescriptionForDisplay === 'function' ? roleDescriptionForDisplay(role.name, role.description) : (role.description ?? ''); %>
  <% const decisionReason = (reason) => typeof decisionReasonForDisplay === 'function' ? decisionReasonForDisplay(reason) : (reason ?? '—'); %>
  <main id="contenido" tabindex="-1" class="container">
    <section class="card" aria-labelledby="role-admin-title">
      <div class="page-heading"><div><h1 id="role-admin-title">Roles y permisos</h1><p>Los cambios requieren autorización vigente, motivo y registro de auditoría.</p></div></div>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    </section>

    <% if (capabilities['M01.requests.read']) { %><section class="card" aria-labelledby="requests-title">
      <div class="page-heading"><h2 id="requests-title">Solicitudes de cambio</h2></div>
      <% const pendingRequests = requests.filter((request) => request.status === 'pending_approval'); %>
      <% if (pendingRequests.length) { %>
        <div class="table-wrap" role="region" aria-label="Administraci&#243;n de roles y permisos" tabindex="0"><table><thead><tr><th scope="col">Acción</th><th scope="col">Usuario</th><th scope="col">Rol</th><th scope="col">Motivo</th><th scope="col">Vence</th><th scope="col">Decisión</th></tr></thead><tbody>
          <% pendingRequests.forEach((request) => { %><tr>
            <td><%= request.action === 'assign' ? 'Asignar' : 'Revocar' %></td><td><%= request.targetUserId ?? '—' %></td><td><%= displayLabel(request.roleName ?? request.roleId) %></td><td><%= request.reason %></td><td><%= request.expiresAt %></td>
            <td><div class="actions"><% if (request.canDecide) { %><% ['approve','reject'].forEach((decision) => { %>
              <form action="/roles/solicitudes/decision" method="POST">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="requestId" value="<%= request.id %>"><input type="hidden" name="decision" value="<%= decision %>">
                <label class="sr-only" for="reason-<%= decision %>-<%= request.id %>">Motivo de <%= decision === 'approve' ? 'aprobación' : 'rechazo' %></label>
                <input class="form-control" id="reason-<%= decision %>-<%= request.id %>" name="reason" required maxlength="4000" placeholder="Motivo obligatorio">
                <button class="btn <%= decision === 'approve' ? 'btn-primary' : 'btn-danger' %>" type="submit"><%= decision === 'approve' ? 'Aprobar' : 'Rechazar' %></button>
              </form><% }); %><% } else { %><span>Sin permiso de decisión</span><% } %></div></td>
          </tr><% }); %>
        </tbody></table></div>
      <% } else { %><p class="empty-state">No hay solicitudes pendientes.</p><% } %>
      <details><summary>Historial de solicitudes</summary><div class="table-wrap" role="region" aria-label="Administraci&#243;n de roles y permisos" tabindex="0"><table><thead><tr><th scope="col">ID</th><th scope="col">Acción</th><th scope="col">Estado</th><th scope="col">Solicitante</th><th scope="col">Decisor</th><th scope="col">Motivo de decisión</th></tr></thead><tbody>
        <% requests.filter((request) => request.status !== 'pending_approval').forEach((request) => { %><tr><td><%= request.id %></td><td><%= request.action === 'assign' ? 'Asignación' : request.action === 'revoke' ? 'Revocación' : displayLabel(request.action) %></td><td><span class="status-pill" data-state="<%= request.status %>"><%= displayLabel(request.status) %></span></td><td><%= request.requestedBy %></td><td><%= request.decidedBy ?? 'Sistema' %></td><td><%= decisionReason(request.decisionReason) %></td></tr><% }); %>
      </tbody></table></div></details>
    </section><% } %>

    <% if (capabilities['M01.roles.manage']) { %><section class="card" aria-labelledby="initial-authority-title">
      <div class="page-heading"><h2 id="initial-authority-title">Autoridad institucional inicial</h2></div>
      <p class="form-help">La autoridad técnica global no concede autoridad institucional. Una designación requiere referencia institucional verificable y aprobación de un segundo administrador; este formulario no selecciona titulares automáticamente.</p>
      <% const availablePlans = (typeof scopeResources !== 'undefined' ? scopeResources : []).filter((resource) => resource.type === 'plan'); %>
      <details><summary>Registrar una nominación formal</summary>
        <form action="/roles/autoridad-inicial/solicitudes" method="POST" class="form-grid">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <div class="form-group"><div class="field"><label for="authority-target-user">ID del titular designado</label><input class="form-control" id="authority-target-user" name="targetUserId" inputmode="numeric" pattern="[1-9][0-9]*" required></div></div>
          <div class="form-group"><div class="field"><label for="authority-plan">Plan</label><select class="form-control" id="authority-plan" name="planId" required><option value="">Selecciona un plan</option><% availablePlans.forEach((plan) => { %><option value="<%= plan.id %>">Plan <%= plan.id %> — <%= plan.name %></option><% }); %></select></div></div>
          <div class="form-group"><div class="field"><label for="authority-reference">Referencia del acto institucional</label><input class="form-control" id="authority-reference" name="institutionalReference" required maxlength="255"></div></div>
          <div class="form-group"><div class="field"><label for="authority-valid-from">Inicio (ISO 8601 con zona horaria, opcional)</label><input class="form-control" id="authority-valid-from" name="validFrom" placeholder="2026-11-18T09:00:00Z"></div></div>
          <div class="form-group"><div class="field"><label for="authority-valid-until">Vencimiento (ISO 8601 con zona horaria)</label><input class="form-control" id="authority-valid-until" name="validUntil" required placeholder="2027-11-18T09:00:00Z"></div></div>
          <div class="form-group form-grid__full"><div class="field"><label for="authority-reason">Motivo de la nominación</label><textarea class="form-control" id="authority-reason" name="reason" required maxlength="4000"></textarea></div></div>
          <button class="btn btn-primary" type="submit">Registrar nominación pendiente</button>
        </form>
      </details>
      <% const authorityQueue = typeof authorityRequests !== 'undefined' ? authorityRequests : []; %>
      <% const pendingAuthority = authorityQueue.filter((request) => request.status === 'pending'); %>
      <% if (pendingAuthority.length) { %>
        <h3>Pendientes de segunda aprobación</h3>
        <% pendingAuthority.forEach((request) => { %><article class="card" aria-label="Nominación institucional pendiente">
          <p><strong><%= request.targetName %> (ID <%= request.targetUserId %>)</strong> — Plan <%= request.planId %>: <%= request.planName %></p>
          <p>Referencia institucional: <code><%= request.institutionalReference %></code></p>
          <p>Solicitada por <%= request.requesterName %> (ID <%= request.requestedBy %>); vigencia <%= request.validFrom %> a <%= request.validUntil %>.</p>
          <% ['approve','reject'].forEach((decision) => { %><form action="/roles/autoridad-inicial/decision" method="POST" class="form-grid">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="requestId" value="<%= request.id %>"><input type="hidden" name="decision" value="<%= decision %>">
            <div class="form-group"><div class="field"><label for="authority-ref-<%= decision %>-<%= request.id %>">Confirma la referencia institucional</label><input class="form-control" id="authority-ref-<%= decision %>-<%= request.id %>" name="institutionalReference" required maxlength="255"></div></div>
            <div class="form-group"><div class="field"><label for="authority-decision-reason-<%= decision %>-<%= request.id %>">Motivo de <%= decision === 'approve' ? 'aprobación' : 'rechazo' %></label><input class="form-control" id="authority-decision-reason-<%= decision %>-<%= request.id %>" name="reason" required maxlength="4000"></div></div>
            <button class="btn <%= decision === 'approve' ? 'btn-primary' : 'btn-danger' %>" type="submit"><%= decision === 'approve' ? 'Aprobar nominación' : 'Rechazar nominación' %></button>
          </form><% }); %>
        </article><% }); %>
      <% } else { %><p class="empty-state">No hay nominaciones pendientes.</p><% } %>
      <details><summary>Historial de designaciones iniciales</summary>
        <% if (authorityQueue.some((request) => request.status !== 'pending')) { %>
          <div class="table-wrap" role="region" aria-label="Historial de autoridad institucional" tabindex="0"><table><thead><tr><th>Titular</th><th>Plan</th><th>Referencia</th><th>Estado</th><th>Decisor</th><th>Motivo de decisión</th><th>Asignación</th></tr></thead><tbody>
            <% authorityQueue.filter((request) => request.status !== 'pending').forEach((request) => { %><tr><td><%= request.targetName %> (ID <%= request.targetUserId %>)</td><td>Plan <%= request.planId %> — <%= request.planName %></td><td><%= request.institutionalReference %></td><td><%= displayLabel(request.status) %></td><td><%= request.deciderName ?? '—' %></td><td><%= decisionReason(request.decisionReason) %></td><td><%= request.assignmentId ?? '—' %></td></tr><% }); %>
          </tbody></table></div>
        <% } else { %><p class="empty-state">Todavía no hay decisiones registradas.</p><% } %>
      </details>
    </section><% } %>

    <% if (capabilities['M01.assignments.read']) { %><section class="card" aria-labelledby="assignments-title">
      <div class="page-heading"><h2 id="assignments-title">Asignaciones</h2></div>
      <form action="/roles" method="GET" class="form-actions">
        <div class="form-group"><label for="assignment-user-id">Consultar por ID de usuario</label><input class="form-control" id="assignment-user-id" name="userId" inputmode="numeric" pattern="[1-9][0-9]*" value="<%= selectedUserId %>" required></div>
        <button class="btn btn-secondary" type="submit">Consultar asignaciones</button>
      </form>
      <% if (selectedUserId) { %>
        <% if (assignments.length) { %><div class="table-wrap" role="region" aria-label="Administraci&#243;n de roles y permisos" tabindex="0"><table><thead><tr><th scope="col">Asignación</th><th scope="col">Rol</th><th scope="col">Ámbito</th><th scope="col">Vigencia</th><th scope="col">Estado</th><th scope="col">Revocar</th></tr></thead><tbody>
          <% assignments.forEach((assignment) => { %><tr><td><code><%= assignment.id %></code></td><td><%= displayLabel(assignment.roleName) %></td><td><%= assignment.scopeRef ?? 'Global' %></td><td><%= assignment.validFrom %> — <%= assignment.validUntil ?? 'sin vencimiento' %></td><td><span class="status-pill" data-state="<%= assignment.status %>"><%= displayLabel(assignment.status) %></span></td><td>
            <% if (assignment.canRevoke && ['active','scheduled'].includes(assignment.status)) { %><form action="/roles/revocaciones" method="POST" data-confirm="¿Confirmas enviar la solicitud de revocación de este rol?"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="assignmentId" value="<%= assignment.id %>"><label class="sr-only" for="revoke-reason-<%= assignment.id %>">Motivo de revocación</label><input class="form-control" id="revoke-reason-<%= assignment.id %>" name="reason" maxlength="4000" required placeholder="Motivo"><button class="btn btn-danger" type="submit">Solicitar revocación</button></form><% } %>
          </td></tr><% }); %>
        </tbody></table></div><% } else { %><p class="empty-state">No se encontraron asignaciones.</p><% } %>
      <% } %>
    </section><% } %>

    <% if (capabilities['assign-role']) { %><section class="card" aria-labelledby="institutional-assignment-title">
      <div class="page-heading"><h2 id="institutional-assignment-title">Asignaciones en ámbitos autorizados</h2></div>
      <p class="form-help">Cada rol debe estar habilitado explícitamente para un recurso y el operador debe tener autoridad vigente en ese mismo ámbito. El rol de autoridad institucional inicial no puede asignarse desde este formulario.</p>
      <details open><summary>Solicitar una asignación</summary>
        <form action="/roles/asignaciones" method="POST" class="form-grid" data-role-assignment-form>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <div class="form-group"><div class="field"><label for="target-user">ID de usuario</label><input class="form-control" id="target-user" name="targetUserId" inputmode="numeric" pattern="[1-9][0-9]*" required data-scope-target></div></div>
          <div class="form-group"><div class="field"><label for="target-role">Rol</label><select class="form-control" id="target-role" name="roleId" required data-scope-role><option value="">Selecciona un rol</option><% roles.filter((role) => role.name !== 'scope_authority_manager').forEach((role) => { %><option value="<%= role.id %>" data-requires-scope="<%= role.requiresScope ? 'true' : 'false' %>"><%= displayLabel(role.name) %></option><% }); %></select></div></div>
          <div class="form-group"><div class="field"><label for="scope-resource">Recurso institucional</label><select class="form-control" id="scope-resource" name="scopeResourceKey" data-scope-resource disabled><option value="">Selecciona primero usuario y rol</option></select><small class="form-help" data-scope-status role="status">Solo aparecerán recursos para los que tienes autorización efectiva.</small></div></div>
          <div class="form-group"><div class="field"><label for="valid-from">Inicio (ISO 8601 con zona horaria, opcional)</label><input class="form-control" id="valid-from" name="validFrom" placeholder="2026-11-18T09:00:00Z"></div></div>
          <div class="form-group"><div class="field"><label for="valid-until">Fin (ISO 8601 con zona horaria, opcional según configuración)</label><input class="form-control" id="valid-until" name="validUntil" placeholder="2027-11-18T09:00:00Z"></div></div>
          <div class="form-group form-grid__full"><div class="field"><label for="assignment-reason">Motivo</label><textarea class="form-control" id="assignment-reason" name="reason" required maxlength="4000"></textarea></div></div>
          <button class="btn btn-primary" type="submit">Enviar asignación</button>
        </form>
      </details>
    </section><% } %>

    <% if (capabilities['M01.roles.read'] || capabilities['M01.roles.manage_scope']) { %><section class="card" aria-labelledby="catalog-title">
      <div class="page-heading"><h2 id="catalog-title">Catálogo de roles</h2></div>
      <div class="table-wrap" role="region" aria-label="Administraci&#243;n de roles y permisos" tabindex="0"><table><thead><tr><th scope="col">Rol</th><th scope="col">Clasificación</th><th scope="col">Ámbito obligatorio</th><th scope="col">Vigencia indefinida</th><th scope="col">Permisos activos</th><th scope="col">Configuración</th></tr></thead><tbody>
        <% roles.forEach((role) => { %><tr><td><strong><%= displayLabel(role.name) %></strong><br><%= roleDescription(role) %></td><td><%= displayLabel(role.classification ?? 'Sin configurar') %></td><td><%= role.requiresScope ? 'Sí' : 'No' %></td><td><%= role.allowOpenEndedAssignment ? 'Sí' : 'No' %></td><td><%= role.permissions.filter((permission) => permission.active).length %></td><td>
          <% if (capabilities['M01.roles.manage']) { %><form action="/roles/configuracion" method="POST"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="roleId" value="<%= role.id %>">
            <label for="class-<%= role.id %>">Clasificación</label><select class="form-control" id="class-<%= role.id %>" name="classification"><option value="ordinary" <%= role.classification === 'ordinary' ? 'selected' : '' %>>Ordinario</option><option value="privileged" <%= role.classification === 'privileged' ? 'selected' : '' %>>Privilegiado</option></select>
            <label><input type="checkbox" name="requiresScope" value="true" <%= role.requiresScope ? 'checked' : '' %>> Ámbito requerido</label>
            <label><input type="checkbox" name="allowOpenEndedAssignment" value="true" <%= role.allowOpenEndedAssignment ? 'checked' : '' %>> Permitir vigencia indefinida</label>
            <label for="config-reason-<%= role.id %>">Motivo</label><input class="form-control" id="config-reason-<%= role.id %>" name="reason" maxlength="4000" required>
            <button class="btn btn-secondary" type="submit">Actualizar configuración</button>
          </form><% } else { %><span>Solo lectura</span><% } %>
        </td></tr><% }); %>
      </tbody></table></div>

      <% if (capabilities['M01.roles.manage']) { %><details><summary>Habilitar ámbitos tipados por recurso</summary>
        <p class="form-help">Esta operación vincula explícitamente un recurso a un rol y queda auditada. No otorga al operador autoridad para asignar ese rol en el ámbito.</p>
        <% const availableScopeResources = typeof scopeResources !== 'undefined' ? scopeResources : []; %>
        <form action="/roles/ambitos/recursos" method="POST" class="form-grid">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <div class="form-group"><div class="field"><label for="scope-resource-key">Plan o actividad</label><select class="form-control" id="scope-resource-key" name="resourceKey" required><option value="">Selecciona un recurso</option><% availableScopeResources.forEach((resource) => { const key = `${resource.type}:${resource.id}`; const label = resource.type === 'plan' ? `Plan ${resource.id} — ${resource.name}` : `Actividad ${resource.id} — ${resource.name} (Plan ${resource.planId}: ${resource.planName})`; %><option value="<%= key %>"><%= label %></option><% }); %></select></div></div>
          <div class="form-group"><div class="field"><label for="scope-resource-role">Rol habilitado</label><select class="form-control" id="scope-resource-role" name="roleId" required><option value="">Selecciona un rol con ámbito obligatorio</option><% roles.filter((role) => role.requiresScope).forEach((role) => { %><option value="<%= role.id %>"><%= displayLabel(role.name) %></option><% }); %></select></div></div>
          <div class="form-group form-grid__full"><div class="field"><label for="scope-resource-reason">Motivo</label><textarea class="form-control" id="scope-resource-reason" name="reason" required maxlength="4000"></textarea></div></div>
          <button class="btn btn-primary" type="submit">Habilitar recurso para el rol</button>
        </form>
      </details><% } %>

      <% if (capabilities['M01.permissions.manage']) { %><details><summary>Administrar permisos por rol</summary>
        <% roles.forEach((role) => { const activeCodes = new Set(role.permissions.filter((permission) => permission.active).map((permission) => permission.code)); %>
          <form action="/roles/permisos" method="POST" class="permission-editor">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="roleId" value="<%= role.id %>">
            <h3><%= displayLabel(role.name) %></h3>
            <% permissions.forEach((permission) => { const details = permissionDetails(permission); const codePopoverId = `permission-code-role-${role.id}-${permission.id}`; %><div class="permission-option"><input id="permission-toggle-<%= role.id %>-<%= permission.id %>" type="checkbox" name="permissionCodes" value="<%= permission.code %>" <%= activeCodes.has(permission.code) ? 'checked' : '' %>><div class="permission-option__content"><label for="permission-toggle-<%= role.id %>-<%= permission.id %>"><strong><%= details.name %></strong></label><small><%= details.description %></small></div><button class="permission-code-trigger" type="button" popovertarget="<%= codePopoverId %>" aria-controls="<%= codePopoverId %>" aria-label="Ver código técnico de <%= details.name %>">ⓘ</button><span class="permission-code-popover" id="<%= codePopoverId %>" popover role="note" aria-label="Código técnico de <%= details.name %>"><strong>Código técnico:</strong> <code><%= permission.code %></code></span></div><% }); %>
            <% if (role.name === 'system_administrator') { %><p class="form-help">Los permisos del perfil administrador total están protegidos para evitar pérdida de acceso.</p><% } %>
            <label for="permissions-reason-<%= role.id %>">Motivo de cambio</label><input class="form-control" id="permissions-reason-<%= role.id %>" name="reason" maxlength="4000" required>
            <button class="btn btn-primary" type="submit">Guardar permisos</button>
          </form>
        <% }); %>
      </details><% } %>
      <% if (capabilities['M01.roles.manage']) { %><details><summary>Crear un rol sin permisos asignados</summary>
        <form action="/roles" method="POST" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <div class="form-group"><div class="field"><label for="new-role-name">Nombre</label><input class="form-control" id="new-role-name" name="name" maxlength="100" required></div></div>
          <div class="form-group"><div class="field"><label for="new-role-description">Descripción</label><input class="form-control" id="new-role-description" name="description" maxlength="255"></div></div>
          <div class="form-group"><div class="field"><label for="new-role-class">Clasificación</label><select class="form-control" id="new-role-class" name="classification"><option value="ordinary">Ordinario</option><option value="privileged">Privilegiado (requiere aprobación secundaria en asignaciones)</option></select></div></div>
          <div class="form-group"><label><input type="checkbox" name="requiresScope" value="true" checked> Ámbito requerido</label></div>
          <div class="form-group"><label><input type="checkbox" name="allowOpenEndedAssignment" value="true"> Permitir vigencia indefinida</label></div>
          <div class="form-group form-grid__full"><div class="field"><label for="new-role-reason">Motivo</label><textarea class="form-control" id="new-role-reason" name="reason" required maxlength="4000"></textarea></div></div>
          <button class="btn btn-primary" type="submit">Crear rol</button>
        </form>
      </details><% } %>
    </section><% } %>

    <% if (capabilities['M01.permissions.read']) { %><section class="card" aria-labelledby="permission-catalog-title">
      <div class="page-heading"><h2 id="permission-catalog-title">Catálogo de permisos</h2></div>
      <div class="table-wrap" role="region" aria-label="Administraci&#243;n de roles y permisos" tabindex="0"><table><thead><tr><th scope="col">Permiso</th><th scope="col">Descripción funcional</th><th scope="col">Estado</th><% if (capabilities['M01.permissions.manage']) { %><th scope="col">Cambiar</th><% } %></tr></thead><tbody>
        <% permissions.forEach((permission) => { const details = permissionDetails(permission); const codePopoverId = `permission-code-catalog-${permission.id}`; %><tr><td><strong><%= details.name %></strong> <button class="permission-code-trigger" type="button" popovertarget="<%= codePopoverId %>" aria-controls="<%= codePopoverId %>" aria-label="Ver código técnico de <%= details.name %>">ⓘ</button><span class="permission-code-popover" id="<%= codePopoverId %>" popover role="note" aria-label="Código técnico de <%= details.name %>"><strong>Código técnico:</strong> <code><%= permission.code %></code></span></td><td><%= details.description %></td><td><%= permission.active ? 'Activo' : 'Desactivado' %></td><% if (capabilities['M01.permissions.manage']) { %><td><form action="/roles/permisos/estado" method="POST"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="code" value="<%= permission.code %>"><input type="hidden" name="active" value="<%= permission.active ? 'false' : 'true' %>"><label for="permission-reason-<%= permission.id %>">Motivo</label><input class="form-control" id="permission-reason-<%= permission.id %>" name="reason" required maxlength="4000"><button class="btn btn-secondary" type="submit"><%= permission.active ? 'Desactivar' : 'Activar' %></button></form></td><% } %></tr><% }); %>
      </tbody></table></div>
      <p class="form-help">Desactivar un permiso retira su efecto para todos los roles. El registro y las asociaciones históricas se conservan.</p>
    </section><% } %>
  </main>
</body>
</html>
