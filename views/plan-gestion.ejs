<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Expediente institucional | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body records-page workflow-page">
<%- include('partials/navigation',{active:'planes',pageTitle:'Expediente institucional',navigation}) %>
<main id="contenido" tabindex="-1" class="container"><section class="card">
<div class="page-heading"><div><h1>Expediente institucional</h1><p>Formulación, revisión y decisiones del plan, separadas de actividades y seguimientos.</p></div><a class="btn btn-secondary" href="/planeacion">Bandeja de Planeación</a></div>
<% if(error){ %><p class="alert alert-error" role="alert"><%= error %></p><% } %><% if(notice){ %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<% if(recovery?.input){ %><details class="institutional-section" open><summary>Propuesta conservada tras el error</summary><dl class="workflow-summary"><% if(recovery.kind==='profile'){ for(const [key,label] of [['fecha_inicio','Inicio propuesto'],['fecha_fin','Finalizaci&#243;n propuesta'],['responsable_propuesto_id','Cuenta propuesta']]){ %><dt><%- label %></dt><dd><%= recovery.input[key]||'Sin diligenciar' %></dd><% }}else{ %><dt>Observaci&#243;n conservada</dt><dd class="workflow-note"><%= recovery.input.observacion||'Sin observaci&#243;n' %></dd><% } %></dl></details><% } %>
<% if(data){ const profile=data.profile;const edited=recovery?.kind==='profile'?recovery.input:null;const input=edited||profile||{};const report=recovery?.validation||data.validation; %>
<section class="workflow-summary"><h2>Plan #<%= data.plan.id_plan %>: <%= data.plan.nombre %></h2><p><strong>Estado institucional: <%= profile?data.labels[profile.estado]:'Pendiente de incorporación del estado heredado' %></strong></p><p>Estado heredado conservado: <%= data.plan.estado||'Sin estado' %>. Versión del expediente: <%= profile?.revision??'Sin incorporar' %>.</p><p>Responsable propuesto en la formulaci&#243;n: <%= data.plan.institucional?.responsable_principal||'Sin definir' %>. La propuesta no equivale a una designaci&#243;n autorizada.</p><a href="/planes">Consultar formulación</a></section>
<% if(recovery){ %><p class="alert" role="status">Se conserva lo escrito. Compáralo antes de <a href="/planes/<%= data.plan.id_plan %>/gestion?discard=1">descartar la recuperación y cargar la versión vigente</a>.</p><% } %>
<section class="institutional-section" aria-labelledby="submission-check"><h2 id="submission-check">Preparación para presentar</h2><p>Guardar borradores incompletos sigue permitido. Esta comprobación no presenta ni aprueba el plan.</p>
<% if(report.complete){ %><p role="status">La información y sus confirmaciones están completas. La presentación requiere además una autoridad habilitada.</p><% } %>
<% if(report.missing?.length){ %><h3>Datos pendientes</h3><ul><% report.missing.forEach(item=>{ %><li><%= item.message %></li><% }); %></ul><% } %>
<% if(report.unresolved?.length){ %><h3>Confirmaciones institucionales pendientes</h3><ul><% report.unresolved.forEach(item=>{ %><li><%= item.message %></li><% }); %></ul><% } %>
<a class="btn btn-secondary" href="/planes/<%= data.plan.id_plan %>/gestion">Comprobar de nuevo los datos guardados</a></section>
<% if(data.canEditProfile){ %><form method="post" action="/planes/<%= data.plan.id_plan %>/gestion/ficha" class="form-grid institutional-section" data-workflow-profile><h2 class="form-grid__full">Fechas y propuesta de responsabilidad</h2><p class="form-help form-grid__full">Campos opcionales para preparar la presentación. El ID de una cuenta activa no acredita su designación institucional y no concede permisos. La propuesta se mantiene separada del creador.</p><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= input.revision??profile.revision %>"><div class="field"><label for="workflow-start">Inicio del plan</label><input id="workflow-start" name="fecha_inicio" type="date" value="<%= input.fecha_inicio||'' %>"></div><div class="field"><label for="workflow-end">Finalización del plan</label><input id="workflow-end" name="fecha_fin" type="date" value="<%= input.fecha_fin||'' %>"></div><div class="field"><label for="workflow-responsible">ID de responsable propuesto</label><input id="workflow-responsible" name="responsable_propuesto_id" inputmode="numeric" pattern="[1-9][0-9]*" value="<%= input.responsable_propuesto_id??'' %>"></div><button class="btn btn-primary" type="submit">Guardar preparación del borrador</button></form>
<% }else if(profile){ %><dl class="workflow-summary"><dt>Inicio del plan</dt><dd><%- include('partials/record-date',{value:profile.fecha_inicio}) %></dd><dt>Finalización del plan</dt><dd><%- include('partials/record-date',{value:profile.fecha_fin}) %></dd><dt>Responsable propuesto</dt><dd><%= profile.responsable_propuesto_id?'Cuenta #'+profile.responsable_propuesto_id:'Sin identificar' %></dd></dl><% } %>
<section class="institutional-section"><h2>Actuaciones institucionales</h2><p class="alert" role="status" data-workflow-unsaved hidden>Hay cambios sin guardar en las fechas o en la propuesta de responsable. Guarda esa preparaci&#243;n antes de realizar una actuaci&#243;n institucional.</p><p id="workflow-authority-help">Las autoridades de presentación, recepción, observación, devolución y aprobación deben confirmarse expresamente. Un permiso general de edición no permite aprobar.</p>
<% const actionLabels={presentar:'Presentar a Planeación',recibir:'Registrar recepción e iniciar revisión',observar:'Registrar observación',devolver:'Devolver para correcciones',aprobar:'Registrar aprobación'};const from={borrador:['presentar'],devuelto:['presentar'],presentado:['recibir'],en_revision:['observar','devolver','aprobar'],aprobado:[]};for(const action of data.actions.filter(a=>(from[profile?.estado]||[]).includes(a.action))){ const saved=recovery?.kind==='action'&&recovery.input.action===action.action?recovery.input:null; %>
<form method="post" action="/planes/<%= data.plan.id_plan %>/gestion/actuacion" class="workflow-action" data-workflow-action><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= saved?.revision??profile.revision %>"><input type="hidden" name="contentVersion" value="<%= saved?.contentVersion??data.contentVersion %>"><input type="hidden" name="action" value="<%= action.action %>">
<% if(action.enabled){ %><label for="note-<%= action.action %>"><%= action.action==='devolver'?'Motivo de devolución':'Observación institucional' %></label><textarea id="note-<%= action.action %>" name="observacion" rows="3" maxlength="10000" <%= ['observar','devolver'].includes(action.action)?'required':'' %>><%= saved?.observacion||'' %></textarea><% }else if(saved?.observacion){ %><p>Observación conservada: <%= saved.observacion %></p><% } %>
<button class="btn btn-secondary" type="submit" <%= action.enabled?'':'disabled' %> aria-describedby="workflow-authority-help"><%= actionLabels[action.action] %></button><% if(!action.enabled){ %><p class="form-help"><%= action.reason==='FORBIDDEN'?'Tu cuenta no tiene permiso para esta actuación.':action.reason==='INVALID_TRANSITION'?'Esta actuación no corresponde al estado actual.':'Pendiente de confirmación de la autoridad institucional; el backend rechaza la operación.' %></p><% } %></form><% } %></section>
<section class="institutional-section"><h2>Historial de actuaciones y observaciones</h2><p>Las observaciones anteriores se conservan después de corregir y presentar nuevamente.</p>
<% if(data.history.length){ %><ol class="workflow-history"><% data.history.forEach(event=>{ %><li><h3><%= actionLabels[event.accion]||'Actualización de preparación' %> · versión <%= event.revision %></h3><p><strong>Autor:</strong> cuenta #<%= event.actor_id %> · <%- include('partials/workflow-instant',{value:event.creado_en}) %></p><p><%= data.labels[event.estado_anterior]||event.estado_anterior %> → <%= data.labels[event.estado_nuevo]||event.estado_nuevo %></p><% if(event.observacion){ %><p class="workflow-note"><%= event.observacion %></p><% } %><% if(event.autoridad_referencia){ %><p>Referencia institucional: <%= event.autoridad_referencia %></p><% } %></li><% }); %></ol><% }else{ %><p class="empty-state">Aún no hay actuaciones registradas. Los historiales anteriores del sistema permanecen conservados.</p><% } %>
<% if(data.nextHistoryCursor){ %><a class="btn btn-secondary" href="/planes/<%= data.plan.id_plan %>/gestion?before=<%= data.nextHistoryCursor %>">Actuaciones anteriores</a><% } %></section>
<% } %></section></main></body></html>
