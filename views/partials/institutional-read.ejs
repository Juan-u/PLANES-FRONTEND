<% if (draft) { %><details class="institutional-section"><summary><%= !draft.modo||draft.modo==='borrador'?'Consultar ficha institucional en borrador':'Consultar ficha institucional' %></summary><p>Información de formulación. No equivale a una aprobación ni modifica indicadores oficiales.</p><dl class="institutional-summary">
<% const labels = { proceso_nombre:'Proceso', problema:'Problema', causas:'Causas', consecuencias:'Consecuencias', objetivo_general:'Objetivo general', meta_descripcion:'Meta', meta_valor:'Valor esperado', meta_unidad:'Unidad', responsable_principal:'Responsable propuesto', nombre:'Nombre', resultado_esperado:'Resultado esperado', id_objetivo:'ID de objetivo específico', id_indicador:'ID de indicador principal', metodo_verificacion:'Método de verificación', prioridad:'Prioridad', evidencias_esperadas:'Evidencias esperadas', observaciones:'Observaciones', instrucciones:'Instrucciones' }; for (const [key,label] of Object.entries(labels)) { if (draft[key] != null) { %><dt><%= label %></dt><dd><%= draft[key] %></dd><% } } %>
</dl>
<% if (draft.objetivos?.length) { %><h3>Objetivos específicos</h3><ul><% draft.objetivos.forEach(o => { %><li>#<%= o.id %>: <%= o.descripcion %></li><% }); %></ul><% } %>
<% if (draft.indicador) { %><h3>Indicador principal</h3><dl><% for (const key of ['nombre','descripcion','formula','unidad','fuente']) { %><dt><%= key %></dt><dd><%= draft.indicador[key] ?? 'Sin definir' %></dd><% } %></dl><% } %>
<% if (draft.recursos?.length) { %><h3>Recursos</h3><ul><% draft.recursos.forEach(r => { %><li><%= r.descripcion %> · Cantidad: <%= r.cantidad ?? 'Sin definir' %> · Costo estimado: <%= r.costo_estimado ?? 'Sin definir' %></li><% }); %></ul><% } %>
</details><% } %>
