<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Actividades | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <header class="app-header"><div class="header-inner"><a class="brand" href="/menu"><span class="brand-mark" aria-hidden="true">PA</span><span>Planes de Acción</span></a><nav class="navbar-links" aria-label="Navegación principal"><a href="/planes">Planes</a><a href="/menu">Menú</a><a href="/logout">Cerrar sesión</a></nav></div></header>
  <main class="container"><section class="card" aria-labelledby="activities-title">
    <div class="page-heading"><div><h1 id="activities-title">Actividades</h1><p>Consulta, filtra y gestiona actividades relacionadas con planes.</p></div></div>
    <% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %><% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
    <form action="/actividades" method="get" class="form-grid">
      <label for="filter-plan">Plan</label><select id="filter-plan" name="planId"><option value="">Todos</option><% plans.forEach((plan) => { %><option value="<%= plan.id_plan %>" <%= String(filters.planId ?? '') === String(plan.id_plan) ? 'selected' : '' %>><%= plan.nombre %></option><% }); %></select>
      <label for="filter-state">Estado</label><input id="filter-state" name="estado" maxlength="50" value="<%= filters.estado ?? '' %>">
      <label for="filter-owner">Responsable</label><input id="filter-owner" name="responsable" maxlength="100" value="<%= filters.responsable ?? '' %>">
      <button class="btn btn-secondary" type="submit">Filtrar</button>
    </form>
    <% if (canCreate) { %><details class="card"><summary>Crear actividad</summary><form action="/actividades/crear" method="post" class="form-grid">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label for="activity-plan">Plan</label><select id="activity-plan" name="id_plan" required><option value="">Selecciona un plan</option><% plans.forEach((plan) => { %><option value="<%= plan.id_plan %>"><%= plan.nombre %></option><% }); %></select>
      <label for="activity-description">Descripción</label><textarea id="activity-description" name="descripcion" rows="3"></textarea><label for="activity-owner">Responsable</label><input id="activity-owner" name="responsable" maxlength="100">
      <label for="activity-start">Fecha de inicio</label><input id="activity-start" name="fecha_inicio" type="date"><label for="activity-end">Fecha de fin</label><input id="activity-end" name="fecha_fin" type="date">
      <label for="activity-state">Estado</label><input id="activity-state" name="estado" maxlength="50"><button class="btn btn-primary" type="submit">Crear actividad</button>
    </form></details><% } %>
    <% if (activities.length) { %><div class="table-wrap"><table><thead><tr><th>ID</th><th>Plan</th><th>Descripción</th><th>Responsable</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Detalle</th><% if (canUpdate) { %><th>Acciones</th><% } %></tr></thead><tbody>
      <% activities.forEach((activity) => { %><tr><td><%= activity.id_actividad %></td><td><%= plans.find((plan) => Number(plan.id_plan) === Number(activity.id_plan))?.nombre ?? activity.id_plan %></td><td><%= activity.descripcion ?? '' %></td><td><%= activity.responsable ?? '' %></td><td><%= activity.fecha_inicio ?? '' %></td><td><%= activity.fecha_fin ?? '' %></td><td><%= activity.estado ?? '' %></td><td><a href="/actividades/<%= activity.id_actividad %>">Ver</a></td>
        <% if (canUpdate) { %><td><details><summary>Editar</summary><form action="/actividades/editar" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= activity.id_actividad %>">
          <label for="description-<%= activity.id_actividad %>">Descripción</label><textarea id="description-<%= activity.id_actividad %>" name="descripcion" rows="3"><%= activity.descripcion ?? '' %></textarea><label for="owner-<%= activity.id_actividad %>">Responsable</label><input id="owner-<%= activity.id_actividad %>" name="responsable" maxlength="100" value="<%= activity.responsable ?? '' %>">
          <label for="start-<%= activity.id_actividad %>">Inicio</label><input id="start-<%= activity.id_actividad %>" name="fecha_inicio" type="date" value="<%= activity.fecha_inicio ? String(activity.fecha_inicio).slice(0,10) : '' %>"><label for="end-<%= activity.id_actividad %>">Fin</label><input id="end-<%= activity.id_actividad %>" name="fecha_fin" type="date" value="<%= activity.fecha_fin ? String(activity.fecha_fin).slice(0,10) : '' %>">
          <label for="state-<%= activity.id_actividad %>">Estado</label><input id="state-<%= activity.id_actividad %>" name="estado" maxlength="50" value="<%= activity.estado ?? '' %>"><button class="btn btn-secondary" type="submit">Guardar</button></form></details></td><% } %></tr><% }); %>
    </tbody></table></div><% } else { %><p class="empty-state">No hay actividades que coincidan con los filtros.</p><% } %>
  </section></main>
</body></html>
