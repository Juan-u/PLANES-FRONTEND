<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Actividades | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body records-page" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>">
  <%- include('partials/navigation', { active: 'actividades', pageTitle: 'Actividades', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>
  <% const displayLabel = (value) => typeof labelForDisplay === 'function' ? labelForDisplay(value) : (value ?? 'Sin estado'); %>
  <% const recovery = typeof recordRecovery === 'undefined' ? null : recordRecovery; const creation = recovery && !recovery.id ? recovery : {}; const editable=record=>!record.flujo||['borrador','devuelto'].includes(record.flujo.estado); const editablePlans=plans.filter(editable); %><main id="contenido" tabindex="-1" class="container"><section class="card" aria-labelledby="activities-title">
    <div class="page-heading"><div><h1 id="activities-title">Actividades</h1><p>Consulta, filtra y gestiona actividades relacionadas con planes.</p></div></div>
    <% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %><% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
    <form action="/actividades" method="get" class="form-grid filter-form">
      <div class="field"><label for="filter-plan">Plan</label><select id="filter-plan" name="planId"><option value="">Todos</option><% plans.forEach((plan) => { %><option value="<%= plan.id_plan %>" <%= String(filters.planId ?? '') === String(plan.id_plan) ? 'selected' : '' %>><%= plan.nombre %></option><% }); %></select></div>
      <div class="field"><label for="filter-state">Estado</label><input id="filter-state" name="estado" maxlength="50" value="<%= filters.estado ?? '' %>"></div>
      <div class="field"><label for="filter-owner">Responsable</label><input id="filter-owner" name="responsable" maxlength="100" value="<%= filters.responsable ?? '' %>"></div>
      <button class="btn btn-secondary" type="submit">Filtrar</button>
    </form>
    <% if (recovery) { %><p class="alert" role="status">Se conserva lo escrito en la operaci&#243;n anterior. Revisa los datos. Si hubo un cambio en otra sesi&#243;n, compara tu borrador antes de <a href="/actividades?discardDraft=1">descartarlo y cargar el registro actualizado</a>.</p><% } %><% if (canCreate && editablePlans.length) { %><details class="card" <%= recovery && !recovery.id ? 'open' : '' %>><summary>Crear actividad</summary><p class="form-help">Plan obligatorio. Los dem&#225;s campos son opcionales.</p><form action="/actividades/crear" method="post" class="form-grid">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>"><div class="field"><label for="activity-plan">Plan</label><select id="activity-plan" name="id_plan" required><option value="">Selecciona un plan</option><% editablePlans.forEach((plan) => { %><option value="<%= plan.id_plan %>" <%= String(creation.id_plan) === String(plan.id_plan) ? 'selected' : '' %>><%= plan.nombre %></option><% }); %></select></div>
      <div class="field"><label for="activity-description">Descripción</label><textarea id="activity-description" name="descripcion" rows="3"><%= creation.descripcion ?? '' %></textarea></div><div class="field"><label for="activity-owner">Responsable</label><input id="activity-owner" name="responsable" maxlength="100" value="<%= creation.responsable ?? '' %>"></div>
      <div class="field"><label for="activity-start">Fecha de inicio</label><input id="activity-start" name="fecha_inicio" type="date" value="<%= creation.fecha_inicio ?? '' %>"></div><div class="field"><label for="activity-end">Fecha de fin</label><input id="activity-end" name="fecha_fin" type="date" value="<%= creation.fecha_fin ?? '' %>"></div>
      <div class="field"><label for="activity-state">Estado</label><input id="activity-state" name="estado" maxlength="50" value="<%= creation.estado ?? '' %>"></div><%- include('partials/institutional-fields', { kind: 'actividad', draft: creation.institucional, linkedPlans: plans }) %><button class="btn btn-primary" type="submit">Crear actividad</button>
    </form></details><% } %>
    <% if (activities.length) { %><div class="table-wrap" role="region" aria-label="Actividades" tabindex="0"><table><thead><tr><th scope="col">ID</th><th scope="col">Plan</th><th scope="col">Descripción</th><th scope="col">Responsable</th><th scope="col">Inicio</th><th scope="col">Fin</th><th scope="col">Estado</th><th scope="col">Detalle</th><% if (canUpdate) { %><th scope="col">Acciones</th><% } %></tr></thead><tbody>
      <% activities.forEach((activity) => { %><tr><td><%= activity.id_actividad %></td><td><%= plans.find((plan) => Number(plan.id_plan) === Number(activity.id_plan))?.nombre ?? activity.id_plan %></td><td><% if (activity.institucional?.nombre) { %><strong><%= activity.institucional.nombre %></strong><br><% } %><%= activity.descripcion ?? '' %><% if (activity.institucional) { %><small class="institutional-draft-label">Ficha en borrador</small><% } %></td><td><%= activity.responsable ?? '' %></td><td><%- include('partials/record-date', { value: activity.fecha_inicio }) %></td><td><%- include('partials/record-date', { value: activity.fecha_fin }) %></td><td><span class="status-pill record-status" data-state="<%= activity.estado %>"><%= displayLabel(activity.estado) %></span></td><td><a href="/actividades/<%= activity.id_actividad %>">Ver</a></td>
        <% if (canUpdate) { %><td><% if(editable(activity)){ %><button class="btn btn-secondary" type="button" data-record-open aria-controls="edit-activity-<%= activity.id_actividad %>" aria-expanded="false">Editar<span class="sr-only"> actividad #<%= activity.id_actividad %></span></button><% }else{ %>Edici&#243;n bloqueada por estado del plan<% } %></td><% } %></tr><% }); %>
    </tbody></table></div>
        <% if (canUpdate) { %><section class="record-editors" aria-label="Edici&#243;n de registros">
          <% activities.filter(editable).forEach((activity) => { %><details class="record-editor" id="edit-activity-<%= activity.id_actividad %>" data-record-editor <%= recovery?.id === String(activity.id_actividad) ? 'open' : '' %>>
            <summary>Editar actividad #<%= activity.id_actividad %></summary>
            <form action="/actividades/editar" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= activity.id_actividad %>">
          <div class="field"><label for="description-<%= activity.id_actividad %>">Descripción</label><textarea id="description-<%= activity.id_actividad %>" name="descripcion" rows="3"><%= activity.descripcion ?? '' %></textarea></div><div class="field"><label for="owner-<%= activity.id_actividad %>">Responsable</label><input id="owner-<%= activity.id_actividad %>" name="responsable" maxlength="100" value="<%= activity.responsable ?? '' %>"></div>
          <div class="field"><label for="start-<%= activity.id_actividad %>">Inicio</label><input id="start-<%= activity.id_actividad %>" name="fecha_inicio" type="date" value="<%= activity.fecha_inicio ? String(activity.fecha_inicio).slice(0,10) : '' %>"></div><div class="field"><label for="end-<%= activity.id_actividad %>">Fin</label><input id="end-<%= activity.id_actividad %>" name="fecha_fin" type="date" value="<%= activity.fecha_fin ? String(activity.fecha_fin).slice(0,10) : '' %>"></div>
          <div class="field"><label for="state-<%= activity.id_actividad %>">Estado</label><input id="state-<%= activity.id_actividad %>" name="estado" maxlength="50" value="<%= activity.estado ?? '' %>"></div><input type="hidden" data-institution-plan value="<%= activity.id_plan %>"><%- include('partials/institutional-fields', { kind: 'actividad', draft: activity.institucional, linkedPlans: plans }) %><div class="form-actions form-grid__full"><button class="btn btn-secondary" type="submit">Guardar</button><button class="btn btn-secondary" type="button" data-record-close>Cancelar</button></div></form>
          </details><% }); %>
        </section><% } %>
<% } else { %><p class="empty-state">No hay actividades que coincidan con los filtros.</p><% } %>
  </section></main>
</body></html>
