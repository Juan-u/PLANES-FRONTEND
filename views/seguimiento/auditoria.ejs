<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Auditoría</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 min-h-screen"><header class="bg-cyan-800 text-white px-6 py-4 flex justify-between"><h1 class="text-xl font-bold">Registro de auditoría</h1><a href="/menu" class="underline">Menú</a></header><main class="max-w-7xl mx-auto p-6"><% if(error){ %><div class="bg-red-100 text-red-800 p-3 rounded mb-4"><%= error %></div><% } %><section class="bg-white p-5 rounded-xl shadow-sm overflow-x-auto"><p class="text-sm text-slate-500 mb-3">Últimos 500 eventos de auditoría disponibles.</p><table class="w-full text-sm"><thead><tr class="text-left bg-slate-50"><th class="p-2">Fecha</th><th class="p-2">Usuario</th><th class="p-2">Acción</th><th class="p-2">Entidad</th><th class="p-2">ID</th><th class="p-2">Detalle</th><th class="p-2">IP</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr class="border-t"><td class="p-2 whitespace-nowrap"><%= new Date(l.fecha).toLocaleString('es-CO') %></td><td class="p-2"><%= l.usuario || 'Sistema' %></td><td class="p-2"><%= l.accion %></td><td class="p-2"><%= l.entidad %></td><td class="p-2"><%= l.entidad_id || '—' %></td><td class="p-2"><%= l.detalle || '—' %></td><td class="p-2"><%= l.ip || '—' %></td></tr><% }) %><% if(!logs.length){ %><tr><td colspan="7" class="p-4 text-center text-slate-500">No hay eventos registrados.</td></tr><% } %></tbody></table></section></main></body></html>