<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de auditoría</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="h-screen flex bg-gray-100">

    <!-- SIDEBAR -->
    <aside class="w-56 shrink-0 bg-blue-700 text-white flex flex-col justify-between p-4">
        <div>
            <p class="font-bold text-xl mb-1">IH</p>
            <p class="text-xs text-blue-200 mb-6">Instituto del Huila</p>

            <nav class="space-y-2">
                <a href="/menu"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    🏠 Menú principal
                </a>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/planes"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    📋 Planes de Acción
                </a>
                <% } %>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/usuarios"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    👥 Usuarios
                </a>
                <% } %>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/roles"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    🔐 Roles
                </a>
                <% } %>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/periodos"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    📊 Periodos
                </a>
                <% } %>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/areas"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    🏢 Áreas
                </a>
                <% } %>
                <a href="/seguimiento"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    📈 Seguimiento
                </a>

              <% if (usuario && Number(usuario.rol_id) === 1) { %>
                <a href="/auditoria"
                   class="block px-3 py-2 rounded bg-blue-600 transition text-sm">
                    🛡️ Auditoría
                </a>
                <% } %>
            </nav>
        </div>

        <a href="/logout"
           onclick="return confirm('¿Desea cerrar sesión?')"
           class="bg-red-500 text-center px-3 py-2 rounded text-sm hover:bg-red-600 transition">
            Salir
        </a>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-1 min-w-0 p-6 overflow-auto">

        <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
            <div>
                <h1 class="text-xl font-bold text-gray-700">
                    Registro de auditoría
                </h1>
                <p class="text-sm text-gray-500 mt-1">
                    Historial de acciones realizadas en el sistema.
                </p>
            </div>

            <a href="/menu"
               class="bg-blue-700 text-white px-4 py-2 rounded hover:bg-blue-800 transition text-sm">
                Volver al menú
            </a>
              <a href="/dashboard"
                   class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">
                    📊 Dashboard
                </a>
        </div>

        <!-- MENSAJE DE ERROR -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-200 text-red-800 p-3 rounded mb-4 text-sm">
                <%= error %>
            </div>
        <% } %>

        <!-- TABLA DE AUDITORÍA -->
        <section class="bg-white rounded shadow overflow-hidden">

            <div class="p-4 border-b flex flex-wrap justify-between items-center gap-2">
                <h2 class="font-semibold text-gray-700">
                    Eventos registrados
                </h2>

                <span class="text-xs text-gray-500">
                    Últimos 500 eventos disponibles
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b">
                            <th class="text-left p-3 font-semibold text-gray-600 whitespace-nowrap">
                                Fecha
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                Usuario
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                Acción
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                Entidad
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                ID
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                Detalle
                            </th>
                            <th class="text-left p-3 font-semibold text-gray-600">
                                IP
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (logs && logs.length > 0) { %>
                            <% logs.forEach(l => { %>
                                <tr class="border-b hover:bg-gray-50 transition">

                                    <td class="p-3 text-gray-500 whitespace-nowrap">
                                        <%= l.fecha
                                            ? new Date(l.fecha).toLocaleString('es-CO')
                                            : '—' %>
                                    </td>

                                    <td class="p-3 font-medium text-gray-700">
                                        <%= l.usuario || 'Sistema' %>
                                    </td>

                                    <td class="p-3 text-gray-700">
                                        <span class="inline-block bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs font-medium">
                                            <%= l.accion || '—' %>
                                        </span>
                                    </td>

                                    <td class="p-3 text-gray-600">
                                        <%= l.entidad || '—' %>
                                    </td>

                                    <td class="p-3 text-gray-500">
                                        <%= l.entidad_id || '—' %>
                                    </td>

                                    <td class="p-3 text-gray-600 min-w-48 max-w-md break-words">
                                        <%= l.detalle || '—' %>
                                    </td>

                                    <td class="p-3 text-gray-500 whitespace-nowrap">
                                        <%= l.ip || '—' %>
                                    </td>

                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7"
                                    class="p-6 text-center text-gray-400 italic">
                                    No hay eventos de auditoría registrados.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-t bg-gray-50 text-xs text-gray-500">
                El registro de auditoría permite consultar las acciones almacenadas en el sistema.
            </div>

        </section>
    </main>

</body>
</html>
