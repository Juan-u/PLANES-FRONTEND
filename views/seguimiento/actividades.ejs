<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Actividades - Instituto del Huila</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-screen flex bg-gray-100">

    <!-- SIDEBAR -->
    <aside class="w-56 shrink-0 bg-blue-700 text-white flex flex-col justify-between p-4 overflow-y-auto">
        <div>
            <p class="font-bold text-xl mb-1">IH</p>
            <p class="text-xs text-blue-200 mb-6">Instituto del Huila</p>

            <nav class="space-y-2">
                <a href="/menu" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">🏠 Menú principal</a>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                    <a href="/planes" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">📋 Planes de Acción</a>
                    <a href="/usuarios" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">👥 Usuarios</a>
                    <a href="/roles" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">🔐 Roles</a>
                    <a href="/periodos" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">📊 Periodos</a>
                    <a href="/areas" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">🏢 Áreas</a>
                <% } %>
                <a href="/seguimiento" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">📈 Seguimiento</a>
                <% if (usuario && Number(usuario.rol_id) === 1) { %>
                    <a href="/auditoria" class="block px-3 py-2 rounded hover:bg-blue-600 transition text-sm">🛡️ Auditoría</a>
                <% } %>
            </nav>
        </div>

        <a href="/logout" onclick="return confirm('¿Desea cerrar sesión?')"
           class="bg-red-500 text-center px-3 py-2 rounded text-sm hover:bg-red-600 transition mt-6">
            Salir
        </a>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-1 min-w-0 p-6 overflow-auto">
        <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
            <div>
                <h1 class="text-xl font-bold text-gray-700">Actividades de Planeación Registradas</h1>
                <p class="text-sm text-gray-500 mt-1">Consolidado general de actividades creadas y su estado de calificación</p>
            </div>
            <a href="/seguimiento" class="bg-blue-700 text-white px-4 py-2 rounded hover:bg-blue-800 transition text-sm">
                ← Volver a Seguimiento
            </a>
        </div>

        <% 
            const actividades = (planeaciones || []).map(act => {
                const cal = (calificaciones || []).find(c => Number(c.planeacion_id) === Number(act.id));
                return {
                    ...act,
                    calificada: !!cal,
                    nota: cal ? cal.resultado_obtenido : null,
                    estado: cal ? (cal.estado_revision || 'Pendiente') : 'Sin calificar'
                };
            });
            const total = actividades.length;
            const calificadas = actividades.filter(a => a.calificada).length;
            const pendientes = total - calificadas;
        %>

        <!-- INDICADORES -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white p-4 rounded shadow border-l-4 border-blue-700">
                <p class="text-xs font-semibold text-gray-500 uppercase">Total Creadas</p>
                <p class="text-2xl font-bold text-gray-800 mt-1"><%= total %></p>
            </div>
            <div class="bg-white p-4 rounded shadow border-l-4 border-green-600">
                <p class="text-xs font-semibold text-gray-500 uppercase">Ya Calificadas</p>
                <p class="text-2xl font-bold text-green-700 mt-1"><%= calificadas %></p>
            </div>
            <div class="bg-white p-4 rounded shadow border-l-4 border-yellow-500">
                <p class="text-xs font-semibold text-gray-500 uppercase">Pendientes por Calificar</p>
                <p class="text-2xl font-bold text-yellow-600 mt-1"><%= pendientes %></p>
            </div>
        </section>

        <!-- FILTROS -->
        <section class="bg-white p-4 rounded shadow mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="text" id="busqueda" placeholder="Buscar por nombre de actividad..."
                   class="border border-gray-300 rounded p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            
            <select id="filtroArea" class="border border-gray-300 rounded p-2 text-sm bg-white">
                <option value="">Todas las áreas</option>
                <% (areas || []).forEach(a => { %>
                    <option value="<%= a.nombre.toLowerCase() %>"><%= a.nombre %></option>
                <% }) %>
            </select>

            <select id="filtroPeriodo" class="border border-gray-300 rounded p-2 text-sm bg-white">
                <option value="">Todos los periodos</option>
                <% (periodos || []).forEach(p => { %>
                    <option value="<%= p.nombre.toLowerCase() %>"><%= p.nombre %></option>
                <% }) %>
            </select>
        </section>

        <!-- TABLA -->
        <section class="bg-white rounded shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b text-gray-600">
                            <th class="text-left p-3 font-semibold">ID</th>
                            <th class="text-left p-3 font-semibold">Actividad</th>
                            <th class="text-left p-3 font-semibold">Plan de Acción</th>
                            <th class="text-left p-3 font-semibold">Área</th>
                            <th class="text-left p-3 font-semibold">Periodo</th>
                            <th class="text-center p-3 font-semibold">Calificación</th>
                            <th class="text-left p-3 font-semibold">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (actividades.length > 0) { %>
                            <% actividades.forEach(act => { %>
                                <tr class="border-b hover:bg-gray-50 fila-act"
                                    data-texto="<%= (act.actividad || '').toLowerCase() %>"
                                    data-area="<%= (act.area || '').toLowerCase() %>"
                                    data-periodo="<%= (act.periodo || '').toLowerCase() %>">
                                    <td class="p-3 text-gray-500">#<%= act.id %></td>
                                    <td class="p-3 font-medium text-gray-800"><%= act.actividad %></td>
                                    <td class="p-3 text-gray-600"><%= act.plan_accion || '—' %></td>
                                    <td class="p-3 text-gray-700"><%= act.area %></td>
                                    <td class="p-3 text-gray-600"><%= act.periodo %></td>
                                    <td class="p-3 text-center font-semibold text-blue-700">
                                        <%= act.nota !== null ? act.nota : '—' %>
                                    </td>
                                    <td class="p-3">
                                        <span class="px-2 py-1 rounded text-xs font-medium
                                            <%= act.estado === 'Aprobada' ? 'bg-green-100 text-green-700' :
                                               act.estado === 'Observada' ? 'bg-red-100 text-red-700' :
                                               act.estado === 'Pendiente' ? 'bg-blue-100 text-blue-700' :
                                               'bg-yellow-100 text-yellow-700' %>">
                                            <%= act.estado %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="p-6 text-center text-gray-400 italic">No hay actividades creadas.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        const busqueda = document.getElementById('busqueda');
        const filtroArea = document.getElementById('filtroArea');
        const filtroPeriodo = document.getElementById('filtroPeriodo');
        const filas = document.querySelectorAll('.fila-act');

        function filtrar() {
            const txt = busqueda.value.toLowerCase();
            const area = filtroArea.value;
            const per = filtroPeriodo.value;

            filas.forEach(f => {
                const ok = f.dataset.texto.includes(txt) &&
                           (!area || f.dataset.area === area) &&
                           (!per || f.dataset.periodo === per);
                f.style.display = ok ? '' : 'none';
            });
        }
        [busqueda, filtroArea, filtroPeriodo].forEach(el => el.addEventListener('input', filtrar));
    </script>
</body>
</html>