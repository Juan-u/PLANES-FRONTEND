<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard institucional</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 min-h-screen"><header class="bg-cyan-800 text-white px-6 py-4 flex justify-between"><div><h1 class="text-xl font-bold">Dashboard de seguimiento</h1><p class="text-cyan-100 text-sm">Sistema de Gestión de Planes de Acción · Instituto del Huila</p></div><a href="/menu" class="underline">Menú</a></header><main class="max-w-6xl mx-auto p-6 space-y-6"><% if(error){ %><div class="bg-red-100 text-red-800 p-3 rounded"><%= error %></div><% } %><% if(dashboard){ %><section class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4"><% const cards=[['Planes activos',dashboard.resumen.planes],['Actividades',dashboard.resumen.actividades],['Periodos abiertos',dashboard.resumen.periodosAbiertos],['Calificaciones',dashboard.resumen.calificaciones],['Pendientes de revisión',dashboard.resumen.pendientes]]; cards.forEach(c=>{ %><div class="bg-white p-5 rounded-xl shadow-sm"><p class="text-sm text-slate-500"><%= c[0] %></p><p class="text-3xl font-bold text-cyan-800 mt-2"><%= c[1] ?? 0 %></p></div><% }) %></section><section class="bg-white rounded-xl shadow-sm p-5"><h2 class="font-bold text-lg mb-4">Consolidado por periodo</h2><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="p-2">Periodo</th><th class="p-2">Estado</th><th class="p-2">Calificaciones</th><th class="p-2">Aprobadas</th><th class="p-2">Observadas</th></tr></thead><tbody><% dashboard.porPeriodo.forEach(p=>{ %><tr class="border-b"><td class="p-2"><%= p.nombre %></td><td class="p-2"><%= p.estado %></td><td class="p-2"><%= p.calificaciones || 0 %></td><td class="p-2"><%= p.aprobadas || 0 %></td><td class="p-2"><%= p.observadas || 0 %></td></tr><% }) %></tbody></table></div></section><section class="bg-white rounded-xl shadow-sm p-5"><h2 class="font-bold text-lg mb-4">Consolidado por área</h2><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="p-2">Área</th><th class="p-2">Actividades</th><th class="p-2">Promedio de calificación</th></tr></thead><tbody><% dashboard.porArea.forEach(a=>{ %><tr class="border-b"><td class="p-2"><%= a.area %></td><td class="p-2"><%= a.actividades || 0 %></td><td class="p-2"><%= a.promedio == null ? 'Sin notas' : Number(a.promedio).toFixed(2) %></td></tr><% }) %></tbody></table></div></section><% } %><section class="bg-white rounded-xl shadow-sm p-5"><h2 class="font-bold text-lg mb-3">Notificaciones recientes</h2><% if(!notificaciones.length){ %><p class="text-slate-500">No hay notificaciones.</p><% } else { notificaciones.slice(0,10).forEach(n=>{ %><div class="border-b py-3"><div class="flex justify-between gap-4"><strong><%= n.titulo %></strong><span class="text-xs text-slate-500"><%= new Date(n.fecha).toLocaleString('es-CO') %></span></div><p class="text-sm text-slate-600 mt-1"><%= n.mensaje %></p></div><% }) } %></section><a href="/seguimiento" class="inline-block bg-cyan-700 text-white px-5 py-3 rounded-lg">Ir a calificaciones y evidencias</a></main></body></html>