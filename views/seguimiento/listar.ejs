<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Calificaciones y evidencias</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 min-h-screen"><header class="bg-cyan-800 text-white px-6 py-4 flex justify-between"><div><h1 class="text-xl font-bold">Calificaciones, evidencias y revisión</h1><p class="text-cyan-100 text-sm">Registro trimestral · Escala de 1 a 4</p></div><a href="/menu" class="underline">Menú</a></header><main class="max-w-7xl mx-auto p-6 space-y-6"><% if(mensaje){ %><div class="bg-cyan-100 text-cyan-900 p-3 rounded"><%= mensaje %></div><% } %><% if(error){ %><div class="bg-red-100 text-red-800 p-3 rounded"><%= error %></div><% } %><section class="grid lg:grid-cols-2 gap-5"><div class="bg-white p-5 rounded-xl shadow-sm"><h2 class="text-lg font-bold mb-4">1. Crear actividad de planeación</h2><form action="/seguimiento/planeacion/crear" method="post" class="space-y-3"><label class="block text-sm">Actividad<textarea name="actividad" required class="w-full border rounded p-2 mt-1" rows="3"></textarea></label><label class="block text-sm">Área<select name="area_id" required class="w-full border rounded p-2 mt-1"><option value="">Selecciona un área</option><% areas.forEach(a=>{ %><option value="<%= a.id %>"><%= a.nombre %></option><% }) %></select></label><label class="block text-sm">Periodo trimestral<select name="periodo_id" required class="w-full border rounded p-2 mt-1"><option value="">Selecciona un periodo</option><% periodos.forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %> — <%= p.estado %></option><% }) %></select></label><button class="bg-cyan-700 text-white rounded px-4 py-2">Crear actividad</button></form></div><div class="bg-white p-5 rounded-xl shadow-sm"><h2 class="text-lg font-bold mb-4">2. Registrar calificación trimestral</h2><form action="/seguimiento/calificaciones/crear" method="post" class="space-y-3"><label class="block text-sm">Actividad<select name="planeacion_id" required class="w-full border rounded p-2 mt-1"><option value="">Selecciona actividad</option><% planeaciones.forEach(p=>{ %><option value="<%= p.id %>"><%= p.actividad %> · <%= p.area %> · <%= p.periodo %></option><% }) %></select></label><label class="block text-sm">Periodo abierto<select name="periodo_id" required class="w-full border rounded p-2 mt-1"><option value="">Selecciona periodo abierto</option><% periodos.filter(p=>p.estado==='Abierto').forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %></option><% }) %></select></label><label class="block text-sm">Calificación (1 a 4)<input type="number" name="resultado_obtenido" min="1" max="4" step="0.01" required class="w-full border rounded p-2 mt-1"></label><label class="block text-sm">Comentario del responsable<textarea name="observacion" rows="2" class="w-full border rounded p-2 mt-1"></textarea></label><button class="bg-cyan-700 text-white rounded px-4 py-2">Registrar calificación</button></form></div></section><section class="bg-white p-5 rounded-xl shadow-sm"><h2 class="text-lg font-bold mb-4">3. Seguimiento y revisión</h2><p class="text-sm text-slate-500 mb-3">Los periodos deben estar abiertos para registrar notas y cargar evidencias. Planeación/Administración puede aprobar u observar cada registro.</p><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left bg-slate-50"><th class="p-2">Actividad / Área</th><th class="p-2">Periodo</th><th class="p-2">Nota</th><th class="p-2">Evidencias</th><th class="p-2">Revisión</th><th class="p-2">Acciones</th></tr></thead><tbody><% calificaciones.forEach(c=>{ %><tr class="border-t align-top"><td class="p-2"><strong><%= c.actividad %></strong><div class="text-xs text-slate-500"><%= c.area %></div><% if(c.observacion){ %><div class="mt-1 text-xs">Comentario: <%= c.observacion %></div><% } %></td><td class="p-2"><%= c.periodo %><div class="text-xs"><%= c.estado_periodo %></div></td><td class="p-2 font-semibold"><%= c.resultado_obtenido %></td><td class="p-2"><span><%= c.total_evidencias %> archivo(s)</span><% if(c.evidencia_ids && c.evidencia_nombres){ const ids=c.evidencia_ids.split(','); const nombres=c.evidencia_nombres.split('|||'); %><div class="my-1 space-y-1"><% ids.forEach((eid,idx)=>{ %><div><a class="text-cyan-800 underline text-xs break-all" href="/seguimiento/evidencias/<%= eid %>/descargar"><%= nombres[idx] || ('Evidencia '+eid) %></a></div><% }) %></div><% } %><form class="mt-2 evidence-form space-y-1" action="/seguimiento/evidencias/subir" method="post"><input type="hidden" name="calificacion_id" value="<%= c.id %>"><input type="hidden" name="filename"><input type="hidden" name="mimetype"><input type="hidden" name="filedata"><input type="file" class="file-input block text-xs max-w-44" required><button class="text-cyan-800 underline text-xs">Cargar evidencia</button><p class="text-xs text-slate-500">Máximo 10 MB</p></form></td><td class="p-2"><span class="inline-block rounded px-2 py-1 text-xs <%= c.estado_revision==='Aprobada'?'bg-green-100 text-green-800':c.estado_revision==='Observada'?'bg-amber-100 text-amber-800':'bg-slate-100 text-slate-700' %>"><%= c.estado_revision %></span><% if(c.observacion_revision){ %><p class="text-xs mt-1"><%= c.observacion_revision %></p><% } %></td><td class="p-2"><% if([1,2].includes(Number(usuario?.rol_id))){ %><form action="/seguimiento/calificaciones/revision" method="post" class="space-y-2 min-w-40"><input type="hidden" name="id" value="<%= c.id %>"><select name="estado" class="border rounded p-1 w-full"><option value="Aprobada">Aprobar</option><option value="Observada">Observar</option></select><textarea name="observacion" placeholder="Observación (si devuelve)" rows="2" class="border rounded p-1 w-full"></textarea><button class="bg-slate-800 text-white rounded px-2 py-1">Guardar revisión</button></form><% } else { %><span class="text-xs text-slate-500">Solo Planeación puede revisar</span><% } %></td></tr><% }) %><% if(!calificaciones.length){ %><tr><td colspan="6" class="p-5 text-center text-slate-500">Todavía no hay calificaciones registradas.</td></tr><% } %></tbody></table></div></section></main><script>
document.querySelectorAll('.evidence-form').forEach(form=>form.addEventListener('submit',async ev=>{ev.preventDefault();const file=form.querySelector('.file-input').files[0];if(!file)return;if(file.size>10*1024*1024){alert('El archivo supera 10 MB');return;}const bytes=await file.arrayBuffer();let binary='';const view=new Uint8Array(bytes);for(let i=0;i<view.length;i+=0x8000)binary+=String.fromCharCode(...view.subarray(i,i+0x8000));form.querySelector('[name=filename]').value=file.name;form.querySelector('[name=mimetype]').value=file.type||'application/octet-stream';form.querySelector('[name=filedata]').value=btoa(binary);form.submit();}));
</script></body></html>