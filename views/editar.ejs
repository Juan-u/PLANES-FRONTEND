<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar usuario | Planes de Acción</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>">
    <%- include('partials/navigation', { active: 'editar', pageTitle: 'Editar usuario', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>

    <main id="contenido" tabindex="-1" class="container container--narrow">
        <section class="card" aria-labelledby="edit-user-title">
            <div class="page-heading">
                <h1 id="edit-user-title">Editar usuario</h1>
            </div>

            <% if (error) { %>
                <div class="alert error" role="alert"><%= error %></div>
            <% } %>

            <form action="/usuarios/editar" method="POST" class="form-grid user-form">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <input type="hidden" name="id" value="<%= usuario.id %>">

                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input class="form-control" type="text" id="nombre" name="nombre" value="<%= usuario.nombre %>" required>
                </div>

                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input class="form-control" type="email" id="email" name="email" value="<%= usuario.email %>" required>
                </div>

                <div class="form-group">
                    <label for="reason">Motivo del cambio</label>
                    <textarea class="form-control" id="reason" name="reason" maxlength="4000" required><%= typeof formValues !== 'undefined' ? formValues.reason ?? '' : '' %></textarea>
                </div>

                <div class="form-actions form-grid__full">
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                    <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
