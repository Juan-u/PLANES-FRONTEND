<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actividades - <%= plan.nombre %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-screen flex bg-gray-100">

    <!-- SIDEBAR -->
    <div class="w-56 bg-cyan-700 text-white flex flex-col justify-between p-4">
        <div>
            <p class="font-bold text-xl mb-1">IH</p>
            <p class="text-xs text-cyan-200 mb-6">Instituto del Huila</p>

            <!-- Progreso de actividades -->
            <% const total = actividades.length;
               const completadas = actividades.filter(a => a.estado === 'Completado').length;
               const pct = total > 0 ? Math.round((completadas / total) * 100) : 0; %>

            <div class="bg-cyan-800 rounded p-3 mb-4 text-xs">
                <p class="text-cyan-200 mb-1">Progreso</p>
                <p class="text-white font-bold text-xl"><%= pct %>%</p>
                <div class="w-full bg-cyan-600 rounded-full h-2 mt-2">
                    <div class="bg-white h-2 rounded-full" style="width:<%= pct %>%"></div>
                </div>
                <p class="text-cyan-300 mt-1"><%= completadas %> / <%= total %> completadas</p>
            </div>

            <nav class="space-y-2">
                <a href="/menu" class="block px-3 py-2 rounded hover:bg-cyan-600 transition text-sm">🏠 Menú</a>
                <a href="/planes" class="block px-3 py-2 rounded hover:bg-cyan-600 transition text-sm">📋 Planes</a>
            </nav>
        </div>
        <a href="/logout" onclick="return confirm('¿Desea cerrar sesión?')"
            class="bg-red-500 text-center px-3 py-2 rounded text-sm hover:bg-red-600 transition">
            Salir
        </a>
    </div>

    <!-- CONTENIDO -->
    <div class="flex-1 p-6 overflow-auto">
        <div class="flex justify-between items-center mb-2">
            <div>
                <a href="/planes" class="text-cyan-700 hover:underline text-xs">← Planes</a>
                <h1 class="text-xl font-bold text-gray-700 mt-1">Actividades</h1>
                <p class="text-sm text-gray-500">Plan: <span class="font-medium"><%= plan.nombre %></span></p>
            </div>
            <a href="/planes/<%= plan.id_plan %>/actividades/nueva"
                class="bg-cyan-700 text-white px-4 py-2 rounded hover:bg-cyan-800 transition text-sm">
                + Nueva Actividad
            </a>
        </div>

        <div class="bg-white rounded shadow overflow-hidden mt-4">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b">
                        <th class="text-left p-3 font-semibold text-gray-600">Descripción</th>
                        <th class="text-left p-3 font-semibold text-gray-600">Responsable</th>
                        <th class="text-left p-3 font-semibold text-gray-600">Fecha Inicio</th>
                        <th class="text-left p-3 font-semibold text-gray-600">Fecha Fin</th>
                        <th class="text-left p-3 font-semibold text-gray-600">Estado</th>
                        <th class="text-left p-3 font-semibold text-gray-600">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% actividades.forEach(act => { %>
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-3 text-gray-700 max-w-xs"><%= act.descripcion %></td>
                        <td class="p-3 text-gray-500"><%= act.responsable || '—' %></td>
                        <td class="p-3 text-gray-500"><%= act.fecha_inicio ? new Date(act.fecha_inicio).toLocaleDateString('es-CO') : '—' %></td>
                        <td class="p-3 text-gray-500"><%= act.fecha_fin ? new Date(act.fecha_fin).toLocaleDateString('es-CO') : '—' %></td>
                        <td class="p-3">
                            <span class="px-2 py-1 rounded-full text-xs font-medium
                                <%= act.estado === 'Completado' ? 'bg-green-100 text-green-700' :
                                    act.estado === 'En proceso' ? 'bg-blue-100 text-blue-700' :
                                    'bg-yellow-100 text-yellow-700' %>">
                                <%= act.estado || 'Pendiente' %>
                            </span>
                        </td>
                        <td class="p-3">
                            <div class="flex gap-2">
                                <a href="/actividades/editar/<%= act.id_actividad %>"
                                    class="bg-cyan-600 text-white px-2 py-1 rounded text-xs hover:bg-cyan-700 transition">
                                    Editar
                                </a>
                                <form action="/actividades/eliminar" method="POST" style="display:inline">
                                    <input type="hidden" name="id" value="<%= act.id_actividad %>">
                                    <input type="hidden" name="id_plan" value="<%= plan.id_plan %>">
                                    <button type="submit"
                                        onclick="return confirm('¿Eliminar esta actividad?')"
                                        class="bg-red-500 text-white px-2 py-1 rounded text-xs hover:bg-red-600 transition">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (actividades.length === 0) { %>
                    <tr>
                        <td colspan="6" class="p-6 text-center text-gray-400 italic">
                            No hay actividades registradas para este plan.
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>
