<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Planeación | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body records-page workflow-page">
<%- include('partials/navigation',{active:'planes',pageTitle:'Planeación',navigation}) %>
<main id="contenido" tabindex="-1" class="container"><section class="card">
<div class="page-heading"><div><h1>Planeación</h1><p>Consulta el estado institucional y conserva el contexto de cada decisión.</p></div><a class="btn btn-secondary" href="/planes">Volver a Planes</a></div>
<% if(error){ %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
<% if(data){ %>
<p class="form-help">La consulta no concede autoridad para revisar o aprobar. Las actuaciones requieren autorización institucional confirmada en el servidor.</p>
<form method="get" action="/planeacion" class="form-grid filter-form"><div class="field"><label for="workflow-state">Estado del plan</label><select id="workflow-state" name="estado"><option value="">Todos</option><% Object.entries(data.labels).forEach(([code,label])=>{ %><option value="<%= code %>" <%= filters.estado===code?'selected':'' %>><%= label %></option><% }); %></select></div><div class="field"><label for="workflow-search">Nombre del plan</label><input id="workflow-search" name="q" maxlength="150" value="<%= typeof filters.q==='string'?filters.q:'' %>"></div><button class="btn btn-secondary" type="submit">Filtrar</button></form>
<% if(data.items.length){ %><div class="table-wrap" role="region" aria-label="Planes en gestión institucional" tabindex="0"><table><thead><tr><th scope="col">Plan</th><th scope="col">Estado institucional</th><th scope="col">Responsable propuesto</th><th scope="col">Última actuación</th><th scope="col">Expediente</th></tr></thead><tbody><% data.items.forEach(item=>{ %><tr><td>#<%= item.id_plan %> · <%= item.nombre %></td><td><span class="status-pill record-status" data-state="<%= item.estado %>"><%= data.labels[item.estado]||item.estado %></span></td><td><%= item.responsable_propuesto_id?'Cuenta #'+item.responsable_propuesto_id:'Sin identificar' %></td><td><%- include('partials/workflow-instant',{value:item.actualizado_en}) %><% if(item.ultimo_actor){ %><br>Cuenta #<%= item.ultimo_actor %><% } %></td><td><a href="/planes/<%= item.id_plan %>/gestion">Consultar expediente</a></td></tr><% }); %></tbody></table></div>
<% }else{ %><p class="empty-state">No hay expedientes incorporados que coincidan con estos filtros. Los registros heredados no se incorporan automáticamente; consulta Planes para abrir su gestión.</p><% } %>
<% if(data.nextCursor){const query=new URLSearchParams({after:String(data.nextCursor),estado:typeof filters.estado==='string'?filters.estado:'',q:typeof filters.q==='string'?filters.q:''}); %><a class="btn btn-secondary" href="/planeacion?<%= query.toString() %>">Siguientes planes</a><% } %>
<% } %></section></main></body></html>
