<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios | Planes de Acción</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>">
    <%- include('partials/navigation', { active: 'usuarios', pageTitle: 'Usuarios', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>
    <% const displayLabel = (value) => typeof labelForDisplay === 'function' ? labelForDisplay(value) : (value ?? 'Sin estado'); %>

    <main id="contenido" tabindex="-1" class="container">
        <section class="card" aria-labelledby="users-title">
            <div class="page-heading">
                <h1 id="users-title">Usuarios</h1>
                <% if (canCreateUsers) { %><a href="/usuarios/nuevo" class="btn btn-primary">+ Nuevo usuario</a><% } %>
            </div>

            <div class="table-wrap" role="region" aria-label="Usuarios" tabindex="0">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Correo</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% usuarios.forEach(usuario => { %>
                            <tr>
                                <td><%= usuario.id %></td>
                                <td><%= usuario.nombre %></td>
                                <td><%= usuario.email %></td>
                                <td><span class="status-pill" data-state="<%= usuario.estado %>"><%= displayLabel(usuario.estado) %></span></td>
                                <td>
                                    <div class="actions">
                                        <% if (canUpdateUsers) { %><a href="/usuarios/editar/<%= usuario.id %>" class="btn btn-primary">Editar</a><% } %>
                                        <% if (String(usuario.estado).toLowerCase() === 'activo') { %>
                                            <% if (canDeactivateUsers) { %><form action="/usuarios/eliminar" method="POST" data-confirm="¿Confirmas la desactivación de esta cuenta?">
                                                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                                <input type="hidden" name="id" value="<%= usuario.id %>">
                                                <label class="sr-only" for="deactivate-reason-<%= usuario.id %>">Motivo de desactivación</label>
                                                <input class="form-control" id="deactivate-reason-<%= usuario.id %>" name="reason" maxlength="4000" required placeholder="Motivo">
                                                <button type="submit" class="btn btn-danger">Desactivar</button>
                                            </form><% } %>
                                        <% } else { %>
                                            <% if (canUpdateUsers) { %><form action="/usuarios/reactivar" method="POST" data-confirm="¿Confirmas la reactivación de esta cuenta?">
                                                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                                <input type="hidden" name="id" value="<%= usuario.id %>">
                                                <label class="sr-only" for="reactivate-reason-<%= usuario.id %>">Motivo de reactivación</label>
                                                <input class="form-control" id="reactivate-reason-<%= usuario.id %>" name="reason" maxlength="4000" required placeholder="Motivo">
                                                <button type="submit" class="btn btn-primary">Reactivar</button>
                                            </form><% } %>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <% if (usuarios.length === 0) { %>
                <p class="empty-state">No hay usuarios registrados.</p>
            <% } %>
        </section>
    </main>
</body>
</html>
