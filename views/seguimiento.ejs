<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seguimiento | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body><header class="app-header"><div class="header-inner"><a class="brand" href="/menu"><span class="brand-mark" aria-hidden="true">PA</span><span>Planes de Acción</span></a><nav class="navbar-links" aria-label="Navegación principal"><a href="/planes">Planes</a><a href="/actividades">Actividades</a><a href="/informes">Informes</a><a href="/logout">Cerrar sesión</a></nav></div></header>
<main class="container"><section class="card" aria-labelledby="followup-title"><div class="page-heading"><div><h1 id="followup-title">Seguimiento de actividades</h1><p>Avances enviados, decisiones y cobertura por período.</p></div></div>
<% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %><% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<form action="/seguimiento" method="get" class="form-grid"><label for="period-select">Período</label><select id="period-select" name="periodId"><% periods.forEach((period) => { %><option value="<%= period.id_periodo %>" <%= String(selectedId) === String(period.id_periodo) ? 'selected' : '' %>><%= period.anio %> · T<%= period.trimestre %> · <%= period.estado %></option><% }); %></select><button class="btn btn-secondary" type="submit">Consultar</button></form>
<% if (canManagePeriods) { %><details class="card"><summary>Crear período de seguimiento</summary><form action="/seguimiento/periodos/crear" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label for="period-year">Año</label><input id="period-year" name="anio" type="number" min="1000" max="9999" required><label for="period-quarter">Trimestre</label><input id="period-quarter" name="trimestre" type="number" min="1" max="4" required><label for="period-start">Fecha inicial</label><input id="period-start" name="fecha_inicio" type="date" required><label for="period-end">Fecha final</label><input id="period-end" name="fecha_fin" type="date" required><button class="btn btn-primary" type="submit">Crear período</button></form></details><% } %>
<% if (summary) { %><div class="card"><h2>Resumen</h2><p>Actividades que vencen en el período: <strong><%= summary.activitiesDue %></strong></p><p>Con seguimiento aprobado: <strong><%= summary.activitiesApproved %></strong></p><p>Pendientes de decisión: <strong><%= summary.activitiesPending %></strong></p><p>Promedio de avance aprobado: <strong><%= typeof summary.summary.promedioAvance === 'number' ? `${summary.summary.promedioAvance}%` : summary.summary.promedioAvance.explicacion %></strong></p><p>Cobertura: <strong><%= typeof summary.summary.coberturaTrimestral === 'number' ? `${summary.summary.coberturaTrimestral}%` : summary.summary.coberturaTrimestral.explicacion %></strong></p></div><% } %>
<% if (periods.length && activities.length) { %><div class="table-wrap"><table><thead><tr><th>Actividad</th><th>Responsable</th><th>Fechas</th><th>Último avance aprobado</th><th>Estado de revisión</th><% if (canCreate) { %><th>Registrar avance</th><% } %></tr></thead><tbody>
<% activities.forEach((activity) => { %><tr><td><a href="/actividades/<%= activity.id_actividad %>">#<%= activity.id_actividad %> · <%= activity.descripcion ?? 'Actividad' %></a></td><td><%= activity.responsable ?? '' %></td><td><%= activity.fecha_inicio ?? '' %> – <%= activity.fecha_fin ?? '' %></td><td><%= activity.porcentaje_aprobado == null ? 'Sin aprobación' : `${activity.porcentaje_aprobado}%` %></td><td><%= activity.id_seguimiento_pendiente ? 'Pendiente' : 'Sin solicitud pendiente' %></td>
<% if (canCreate) { %><td><% if (!activity.id_seguimiento_pendiente && summary.period.estado === 'open') { %><details><summary>Enviar</summary><form action="/seguimiento/crear" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_actividad" value="<%= activity.id_actividad %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><label for="progress-<%= activity.id_actividad %>">Porcentaje de avance</label><input id="progress-<%= activity.id_actividad %>" name="porcentaje" type="number" min="0" max="100" step="0.01" required><label for="observation-<%= activity.id_actividad %>">Observaciones y novedades</label><textarea id="observation-<%= activity.id_actividad %>" name="observaciones" rows="3"></textarea><button class="btn btn-primary" type="submit">Enviar a revisión</button></form></details><% } else if (activity.id_seguimiento_pendiente) { %>Ya existe un envío pendiente<% } else { %>Período cerrado<% } %></td><% } %></tr><% }); %>
</tbody></table></div><% } else if (periods.length) { %><p class="empty-state">No hay actividades con fecha de vencimiento dentro de este período.</p><% } else { %><p class="empty-state">No hay períodos de seguimiento registrados.</p><% } %>
<% if (history.length) { %><h2>Historial de envíos y decisiones</h2><div class="table-wrap"><table><thead><tr><th>Actividad</th><th>Trimestre</th><th>Avance</th><th>Observaciones</th><th>Estado</th><th>Decisión</th><th>Responsable decisión</th><% if (canApprove && summary?.period.estado === 'open') { %><th>Revisar</th><% } %></tr></thead><tbody><% history.forEach((item) => { %><tr><td>#<%= item.id_actividad %></td><td><%= item.anio %> · T<%= item.trimestre %></td><td><%= item.porcentaje %>%</td><td><%= item.observaciones ?? '' %></td><td><%= item.estado %></td><td><%= item.decision ?? '' %><%= item.motivo_decision ? ` · ${item.motivo_decision}` : '' %></td><td><%= item.decidido_por ?? '' %></td>
<% if (canApprove && summary?.period.estado === 'open') { %><td><% if (item.estado === 'pending') { %><form action="/seguimiento/decision" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_seguimiento" value="<%= item.id_seguimiento %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><label for="reason-<%= item.id_seguimiento %>">Motivo</label><input id="reason-<%= item.id_seguimiento %>" name="motivo" required maxlength="2000"><button class="btn btn-primary" name="resultado" value="approved">Aprobar</button><button class="btn btn-secondary" name="resultado" value="rejected">Rechazar</button></form><% } %></td><% } %></tr><% }); %></tbody></table></div><% } %>
<% if (canManagePeriods && summary?.period.estado === 'open') { %><form action="/seguimiento/periodos/cerrar" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><button class="btn btn-secondary" type="submit">Cerrar período</button></form><% } %>
</section></main></body></html>
