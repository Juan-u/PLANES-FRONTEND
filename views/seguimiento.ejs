<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seguimiento | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head>
<body class="app-body" data-time-zone="<%= (typeof timeZone !== 'undefined' ? timeZone : 'America/Bogota') %>"><%- include('partials/navigation', { active: 'seguimiento', pageTitle: 'Seguimiento', navigation: typeof navigation === 'undefined' ? {} : navigation }) %>
<% const displayLabel = (value) => typeof labelForDisplay === 'function' ? labelForDisplay(value) : (value ?? 'Sin estado'); %>
<% const formatFollowupDate = (value) => {
  if (value == null || value === '') return 'Sin fecha';
  // Conserva el día de calendario recibido, incluso si el valor incluye hora y zona.
  const parts = typeof value === 'string' ? /^(\d{4})-(\d{2})-(\d{2})(?:$|T| )/.exec(value) : null;
  return parts ? `${parts[3]}/${parts[2]}/${parts[1]}` : value;
}; %>
<main id="contenido" tabindex="-1" class="container"><section class="card" aria-labelledby="followup-title"><div class="page-heading"><div><h1 id="followup-title">Seguimiento de actividades</h1><p>Avances enviados, decisiones y cobertura por período.</p></div></div>
<% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %><% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<form action="/seguimiento" method="get" class="form-grid filter-form period-filter"><div class="field"><label for="period-select">Período</label><select id="period-select" name="periodId"><% periods.forEach((period) => { %><option value="<%= period.id_periodo %>" <%= String(selectedId) === String(period.id_periodo) ? 'selected' : '' %>><%= period.anio %> · T<%= period.trimestre %> · <%= displayLabel(period.estado) %></option><% }); %></select></div><button class="btn btn-secondary" type="submit">Consultar</button></form>
<% if (canManagePeriods) { %><details class="card"><summary>Crear período de seguimiento</summary><form action="/seguimiento/periodos/crear" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><div class="field"><label for="period-year">Año</label><input id="period-year" name="anio" type="number" min="1000" max="9999" required></div><div class="field"><label for="period-quarter">Trimestre</label><input id="period-quarter" name="trimestre" type="number" min="1" max="4" required></div><div class="field"><label for="period-start">Fecha inicial</label><input id="period-start" name="fecha_inicio" type="date" required></div><div class="field"><label for="period-end">Fecha final</label><input id="period-end" name="fecha_fin" type="date" required></div><button class="btn btn-primary" type="submit">Crear período</button></form></details><% } %>
<% if (summary) { %>
<section class="followup-metrics" aria-label="Resumen del período">
  <% const indicators = [
    ['Actividades que vencen en el período', summary.activitiesDue],
    ['Actividades con seguimiento aprobado', summary.activitiesApproved],
    ['Seguimientos pendientes de decisión', summary.activitiesPending],
    ['Promedio de avance aprobado', summary.summary?.promedioAvance],
    ['Cobertura del seguimiento', summary.summary?.coberturaTrimestral]
  ]; indicators.forEach(([title, value], index) => { %>
  <article class="followup-metric"><h2><%= title %></h2>
    <% if (typeof value === 'number') { %><strong class="followup-metric-value"><%= value %><%= index >= 3 ? '%' : '' %></strong>
    <% } else { %><p class="followup-metric-message"><%= value?.explicacion ?? value ?? 'Sin datos disponibles' %></p><% } %>
  </article>
  <% }); %>
</section>
<% } else { %><p class="empty-state">No hay resumen disponible para el período seleccionado.</p><% } %>
<% if (periods.length && activities.length) { %><div class="table-wrap" role="region" aria-label="Seguimientos del per&#237;odo" tabindex="0"><table class="followup-table"><thead><tr><th scope="col">Actividad</th><th scope="col">Responsable</th><th scope="col">Fechas</th><th scope="col">Último avance aprobado</th><th scope="col">Estado de revisión</th><% if (canCreate) { %><th scope="col">Registrar avance</th><% } %></tr></thead><tbody>
<% activities.forEach((activity) => { %><tr><td><a href="/actividades/<%= activity.id_actividad %>">#<%= activity.id_actividad %> · <%= activity.descripcion ?? 'Actividad' %></a></td><td><%= activity.responsable ?? '' %></td><td class="date-cell"><span class="date-line">Inicio: <%= formatFollowupDate(activity.fecha_inicio) %></span><span class="date-line">Fin: <%= formatFollowupDate(activity.fecha_fin) %></span></td><td class="numeric-cell"><%= activity.porcentaje_aprobado == null ? 'Sin aprobación' : `${activity.porcentaje_aprobado}%` %></td><td><span class="status-pill" data-state="<%= activity.id_seguimiento_pendiente ? 'pending' : 'neutral' %>"><%= activity.id_seguimiento_pendiente ? 'Pendiente' : 'Sin solicitud pendiente' %></span></td>
<% if (canCreate) { %><td><% if (!activity.id_seguimiento_pendiente && summary.period.estado === 'open') { %><details><summary>Enviar</summary><form action="/seguimiento/crear" method="post" class="form-grid"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_actividad" value="<%= activity.id_actividad %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><div class="field"><label for="progress-<%= activity.id_actividad %>">Porcentaje de avance</label><input id="progress-<%= activity.id_actividad %>" name="porcentaje" type="number" min="0" max="100" step="0.01" required></div><div class="field"><label for="observation-<%= activity.id_actividad %>">Observaciones y novedades</label><textarea id="observation-<%= activity.id_actividad %>" name="observaciones" rows="3"></textarea></div><button class="btn btn-primary" type="submit">Enviar a revisión</button></form></details><% } else if (activity.id_seguimiento_pendiente) { %>Ya existe un envío pendiente<% } else { %>Período cerrado<% } %></td><% } %></tr><% }); %>
</tbody></table></div><% } else if (periods.length) { %><p class="empty-state">No hay actividades con fecha de vencimiento dentro de este período.</p><% } else { %><p class="empty-state">No hay períodos de seguimiento registrados.</p><% } %>
<% if (history.length) { %><h2>Historial de envíos y decisiones</h2><div class="table-wrap" role="region" aria-label="Historial de env&#237;os y decisiones" tabindex="0"><table class="followup-history"><thead><tr><th scope="col">Actividad</th><th scope="col">Trimestre</th><th scope="col">Avance</th><th scope="col">Observaciones</th><th scope="col">Estado</th><th scope="col">Decisión</th><th scope="col">Responsable decisión</th><% if (canApprove && summary?.period.estado === 'open') { %><th scope="col">Revisar</th><% } %></tr></thead><tbody><% history.forEach((item) => { %><tr><td>#<%= item.id_actividad %></td><td><%= item.anio %> · T<%= item.trimestre %></td><td class="numeric-cell"><%= item.porcentaje %>%</td><td><%= item.observaciones ?? '' %></td><td><span class="status-pill" data-state="<%= item.estado %>"><%= displayLabel(item.estado) %></span></td><td><%= displayLabel(item.decision) %><%= item.motivo_decision ? ` · ${item.motivo_decision}` : '' %></td><td><%= item.decidido_por ?? '' %></td>
<% if (canApprove && summary?.period.estado === 'open') { %><td><% if (item.estado === 'pending') { %><form action="/seguimiento/decision" method="post" class="form-grid" data-confirm="¿Confirmas registrar la decisión seleccionada para este seguimiento?"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_seguimiento" value="<%= item.id_seguimiento %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><div class="field"><label for="reason-<%= item.id_seguimiento %>">Motivo</label><input id="reason-<%= item.id_seguimiento %>" name="motivo" required maxlength="2000"></div><button class="btn btn-primary" name="resultado" value="approved">Aprobar</button><button class="btn btn-secondary" name="resultado" value="rejected">Rechazar</button></form><% } %></td><% } %></tr><% }); %></tbody></table></div><% } %>
<% if (canManagePeriods && summary?.period.estado === 'open') { %><form action="/seguimiento/periodos/cerrar" method="post" data-confirm="¿Confirmas cerrar este período de seguimiento?"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="id_periodo" value="<%= selectedId %>"><button class="btn btn-secondary" type="submit">Cerrar período</button></form><% } %>
</section></main></body></html>
