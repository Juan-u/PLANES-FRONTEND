<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Plan de Acción</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-screen flex bg-gray-100">

    <!-- SIDEBAR -->
    <div class="w-56 bg-cyan-700 text-white flex flex-col justify-between p-4">
        <div>
            <p class="font-bold text-xl mb-1">IH</p>
            <p class="text-xs text-cyan-200 mb-6">Instituto del Huila</p>
            <nav class="space-y-2">
                <a href="/menu" class="block px-3 py-2 rounded hover:bg-cyan-600 transition text-sm">🏠 Menú</a>
                <a href="/planes" class="block px-3 py-2 rounded hover:bg-cyan-600 transition text-sm">📋 Planes de Acción</a>
            </nav>
        </div>
        <a href="/logout" onclick="return confirm('¿Desea cerrar sesión?')"
            class="bg-red-500 text-center px-3 py-2 rounded text-sm hover:bg-red-600 transition">
            Salir
        </a>
    </div>

    <!-- CONTENIDO -->
    <div class="flex-1 p-6 overflow-auto">
        <div class="max-w-lg">
            <div class="flex items-center gap-3 mb-6">
                <a href="/planes" class="text-cyan-700 hover:underline text-sm">← Volver</a>
                <h1 class="text-xl font-bold text-gray-700">Nuevo Plan de Acción</h1>
            </div>

            <div class="bg-white rounded shadow p-6">
                <% if (error) { %>
                <div class="bg-red-50 border border-red-300 text-red-600 text-sm rounded p-3 mb-4">
                    <%= error %>
                </div>
                <% } %>

                <form action="/planes/crear" method="POST" class="space-y-4">
                    <div>
                        <label class="text-sm font-medium text-gray-700">Nombre del plan *</label>
                        <input type="text" name="nombre" placeholder="Nombre del plan de acción"
                            class="w-full mt-1 p-2 border rounded text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500" required>
                    </div>

                    <div>
                        <label class="text-sm font-medium text-gray-700">Descripción</label>
                        <textarea name="descripcion" rows="3" placeholder="Descripción del plan..."
                            class="w-full mt-1 p-2 border rounded text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 resize-none"></textarea>
                    </div>

                    <div>
                        <label class="text-sm font-medium text-gray-700">Estado</label>
                        <select name="estado"
                            class="w-full mt-1 p-2 border rounded text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Finalizado">Finalizado</option>
                        </select>
                    </div>

                    <div class="flex gap-3 pt-2">
                        <button type="submit"
                            class="flex-1 bg-cyan-700 text-white py-2 rounded hover:bg-cyan-800 transition text-sm">
                            💾 Guardar Plan
                        </button>
                        <a href="/planes"
                            class="flex-1 text-center border border-gray-300 text-gray-600 py-2 rounded hover:bg-gray-50 transition text-sm">
                            ❌ Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>
