<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revisar consulta | Planes de Acción</title><link rel="stylesheet" href="/style.css"></head><body class="app-body report-page">
<%- include('partials/navigation',{active:contextMode?'control-interno':'informes',pageTitle:'Revisar consulta'}) %>
<main class="app-main" id="contenido" tabindex="-1"><section class="card"><h1>No se completó la consulta</h1><p class="alert alert-error" role="alert"><%= message %></p><p>Puedes revisar los filtros sin modificar información institucional.</p>
<form action="<%= contextMode?'/control-interno/contexto':'/informes/institucional' %>" method="get" data-query-progress class="form-grid report-filters"><% for(const [key,value]of Object.entries(filters)){ %><div class="field"><label for="retry-<%= key %>"><%= filterLabels[key]||key %></label><input id="retry-<%= key %>" name="<%= key %>" value="<%= value %>" maxlength="150"></div><% } %><button class="btn btn-primary" type="submit">Revisar y consultar</button><span role="status" data-query-status hidden>Consultando...</span><a class="btn btn-secondary" href="<%= contextMode?'/control-interno':'/informes' %>">Volver al módulo</a></form>
</section></main></body></html>
