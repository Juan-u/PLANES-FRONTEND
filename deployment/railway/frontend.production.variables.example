DEPLOYMENT_PROFILE=railway-production
NODE_ENV=production
APP_HOST=::
PORT=4000
PRODUCTION_MYSQL_SERVICE_NAME=MySQL-EZwX
PRODUCTION_DB_HOST=${{MySQL-EZwX.RAILWAY_PRIVATE_DOMAIN}}
PRODUCTION_DB_NAME=REPLACE_WITH_THE_EXACT_DATABASE_NAME_FROM_RAILWAY
BACKEND_API_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}/api
PUBLIC_ORIGIN=https://REPLACE_WITH_THE_FRONTEND_HTTPS_DOMAIN
SESSION_SECRET=
SESSION_DB_HOST=${{MySQL-EZwX.RAILWAY_PRIVATE_DOMAIN}}
SESSION_DB_PORT=3306
SESSION_DB_NAME=REPLACE_WITH_THE_EXACT_DATABASE_NAME_FROM_RAILWAY
SESSION_DB_USER=planes_web_sessions
SESSION_DB_PASSWORD=
APP_TIME_ZONE=America/Bogota
# RAILWAY_PROJECT_NAME and RAILWAY_ENVIRONMENT_NAME are supplied by Railway.
